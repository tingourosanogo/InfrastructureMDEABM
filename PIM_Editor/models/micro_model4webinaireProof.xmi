<?xml version='1.0' encoding='UTF-8'?>
<xmi:XMI xmlns="http://www.example.org/socioecosystem.en" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ses="http://www.example.org/socioecosystem.en" xmi:version="2.0">
  <SocioEcosystem xsi:type="ses:SocioEcosystem" name="Nouveau Socio-Écosystème" description="Modèle créé avec l'éditeur MDD">
    <properties xsi:type="ses:Resource" xmi:id="resource_001" id="resource_001" name="Lait Brut" description="Potentiel de lait disponible dans le troupeau" pos_x="-180.0" pos_y="-3.0" width="150.0" height="45.0" unit="Litres" quantity="800.0" isRenewable="false">
      <heldBy href="#agent_001" type="straight"/>
    </properties>
    <properties xsi:type="ses:Resource" xmi:id="resource_002" id="resource_002" name="Lait Produit" description="Lait extrait et prêt pour consommation/vente" pos_x="65.0" pos_y="-4.0" width="150.0" height="45.0" unit="Litres" quantity="1000.0" isRenewable="false">
      <heldBy href="#agent_001" type="straight"/>
    </properties>
    <processes xsi:type="ses:TransformationProcess" xmi:id="process_001" id="process_001" name="Traite" pos_x="-76.0" pos_y="85.0" width="160.0" height="90.0" transformationType="Production">
      <subjects href="#agent_001" type="straight"/>
      <involvedResources href="#resource_001" type="straight"/>
      <affectsResources href="#resource_002" type="straight"/>
    </processes>
    <agents xmi:id="agent_001" id="agent_001" name="Ménage pastoral" pos_x="-80.0" pos_y="-120.0" width="164.0" height="42.0" type="Social">
      <isSubjectOf href="#process_001" type="straight"/>
      <holdsResources href="#resource_001" type="straight"/>
      <holdsResources href="#resource_002" type="straight"/>
    </agents>
  </SocioEcosystem>
