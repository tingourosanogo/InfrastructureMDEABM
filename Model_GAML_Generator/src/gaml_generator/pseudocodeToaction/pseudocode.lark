%import common.WS_INLINE
%import common.NEWLINE
%import common.INT
%import common.FLOAT

%ignore WS_INLINE
%ignore NEWLINE

// Commentaires inline ignorés (pas besoin de les garder dans l'AST)
%ignore "//" /[^\n]*/

start: stmt*

// === TERMINAUX ===
NUMBER: INT | FLOAT
STRING: /"(\\.|[^"])*"/
BOOL: "true" | "false"
BIN_OP: ">=" | "<=" | "==" | "!=" | "and" | "or" | "AND" | "OR" | "&&" | "||" | "+" | "-" | "*" | "/" | "^" | ">" | "<"
UN_OP: "not" | "NOT" | "!" | "-"
SEMI: ";"
RESOURCE_ID: /resource_\d+/
PROPERTY_ID: /property_\d+/
ID: /[a-zA-Z_][a-zA-Z_0-9]*/
CNAME: ID


// === RÈGLES BASIQUES ===
var_name: ID
// annotation: "/*" (RESOURCE_ID | PROPERTY_ID) "*/"
assign_op: "+=" | "-=" | "*=" | "/=" | "=" 

// === EXPRESSIONS ===
atom: NUMBER | STRING | BOOL | var_name | list_literal // | index_access
func_call: CNAME "(" (expr ("," expr)*)? ")" SEMI?

list_literal: "[" (expr ("," expr)*)? "]"
// index_access: var_name "[" expr "]"  // Fusion array/dict (pas de distinction pour l'instant)

expr: atom
    | expr BIN_OP expr
    | UN_OP expr
    | "(" expr ")"
    | func_call

value: NUMBER | STRING | BOOL

// === INSTRUCTIONS ===
annotation: "/*" (RESOURCE_ID | PROPERTY_ID) "*/"
break_stmt: "break" SEMI
// ASSIGNMENT - Version robuste (annotation autorisée avant OU après l'opérateur)
assign_stmt: var_name (annotation)? assign_op expr (annotation)? SEMI (annotation)?
           | var_name (annotation)? SEMI (annotation)?


if_stmt: "if" "(" expr ")" "{" stmt* "}" else_if_stmt* else_stmt?
else_if_stmt: "else" "if" "(" expr ")" "{" stmt* "}"
else_stmt: "else" "{" stmt* "}"

for_each_stmt: "for" "each" var_name "in" expr "{" stmt* "}"
for_range_stmt: "for" var_name "=" expr "to" expr ("step" expr)? "{" stmt* "}"

while_stmt: "while" "(" expr ")" "{" stmt* "}"
repeat_until_stmt: "repeat" "{" stmt* "}" "until" "(" expr ")" SEMI?

switch_stmt: "switch" "(" expr ")" "{" case_stmt* default_stmt? "}"
case_stmt: "case" value ":" stmt* break_stmt  // break obligatoire pour éviter conflit
default_stmt: "default" ":" stmt*

procedure_decl: "procedure" CNAME "(" (param_decl ("," param_decl)*)? ")" "{" stmt* "}"
function_decl: "function" CNAME "(" (param_decl ("," param_decl)*)? ")" "{" stmt* return_stmt? "}"

param_decl: (TYPE)? var_name

TYPE: "int" | "float" | "string" | "bool" | "point" | "agent" | "list" | "map"

return_stmt: "return" expr SEMI

io_stmt: ("read" var_name | "print" expr) SEMI

// === POINT D'ENTRÉE ===
stmt: assign_stmt
    | if_stmt
    | else_if_stmt
    | for_each_stmt
    | for_range_stmt
    | while_stmt
    | repeat_until_stmt
    | switch_stmt
    | break_stmt
    | return_stmt
    | io_stmt
    | procedure_decl
    | function_decl
    | func_call 