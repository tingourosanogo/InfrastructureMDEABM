      <dependsOnParameters href="#property_108" label="Slaughter Prop. Young Male" type="straight"/>
      <dependsOnParameters href="#property_109" label="Slaughter Prop. Young Female" type="straight"/>
      <dependsOnParameters href="#property_110" label="Slaughter Prop. Sub-Adult Male" type="straight"/>
      <dependsOnParameters href="#property_111" label="Slaughter Prop. Sub-Adult Female" type="straight"/>
      <dependsOnParameters href="#property_112" label="Slaughter Prop. Adult Male" type="straight"/>
