      <involvedResources href="#resource_025" label="Adult Female Count" type="straight"/>
      <involvedResources href="#resource_073" label="Seasonal Fodder Reliance" type="straight"/>       
      <involvedResources href="#resource_042" label="Seasonal Water" type="straight"/>
      <involvedResources href="#resource_010" label="Rainfall" type="straight"/>
