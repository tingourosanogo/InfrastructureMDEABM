    <processes xsi:type="ses:TransformationProcess" xmi:id="process_017" id="process_017" name="meat_sale" description="Sale of processed meat stock, tracking the cumulative volume sold." comment="Consumes the processed meat inventory (resource_058) and records the total mass sold into a cumulative metric (resource_059)." pos_x="-1887.5379999999998" pos_y="-377.7119999999998" width="110.0" height="44.0" equation="MeatSoldCum += ProcessedMeatStock; DeltaStock = -ProcessedMeatStock" pseudoCode="
      // quantity to sell is the current stock
      to_sell = processed_meat_stock /* resource_058 */;
      market_price = market_price_meat /* property_030 */;

      if (to_sell &gt; 0) {
        // Calculate revenue (The financial transaction is abstracted away, but revenue is calculated for context)
        revenue = to_sell * market_price;
        
        // Execute transaction: Decrease Stock and Update Cumulative Metric

        // 1. Decrease Stock (consumed)
        processed_meat_stock = processed_meat_stock - to_sell;  /* resource_058 */ 
        
        // 2. Update Cumulative Meat Sold Amount
        Meat_Sold_Amount_Cumulative = Meat_Sold_Amount_Cumulative + to_sell /* resource_061 */;
       } 
      else {
        // No stock to sell, no change
        revenue = 0;
        }" transformationType="Modification">
      <subjects href="#agent_022" type="straight"/>
      <objects href="#agent_013" type="straight"/>
      <involvedResources href="#resource_058" label="Processed Meat Stock" type="straight"/>
      <involvedResources href="#resource_061" label="Meat Sold Amount (Cumulative)" type="straight"/>
      <dependsOnParameters href="#property_030" label="Market Price" type="straight"/>
      <affectsResources href="#resource_058" label="Processed Meat Stock" type="straight"/>
      <affectsResources href="#resource_061" label="Meat Sold Amount (Cumulative)" type="straight"/>
    </processes>

    <processes xsi:type="ses:MovementProcess" xmi:id="process_021" id="process_021" name="milk_sale" description="Splitting of produced milk into direct market sales and transfer to Dairy for processing." comment="Determines proportional allocation of raw milk and calculates revenue from direct sales." pos_x="-732.0" pos_y="277.39" width="120.0" height="44.0" equation="MilkSold = Milk * SaleProp; MilkToDairy = Milk * (1 - SaleProp); Revenue = MilkSold * PriceLait" pseudoCode="
      // Total raw milk produced by AgroPastoralHousehold
      total_milk_sale = milk_for_sale /* resource_071 */;
      market_price = market_price_raw_milk /* property_119 */;
      dairy_prop = milk_dairy_prop; /* property_146 */

      if (milk_sold &gt; 0) {
        // 1. Execute Sale (updates Household's Cash)
        income = total_milk_sale * market_price;
        livestock_revenue = livestock_revenue + income;  /* resource_067 */

        // 2. Execute Transfer to Dairy
        milk_to_dairy = total_milk_sale * dairy_prop;
        milk_for_processing = milk_for_processing + milk_to_dairy;  /* resource_029 */ 

        // 3. Update Resources
        // Consume the raw milk input entirely
        milk_for_sale = milk_for_sale - total_milk; /* resource_039 */  
      } else {
        revenue = 0;
      }">
         <subjects href="#agent_005" type="straight"/>
         <objects href="#agent_013" label="Market" type="straight"/>
         <objects href="#agent_023" label="Dairy" type="straight"/>
         <involvedResources href="#resource_071" label="Milk sale" type="straight"/>      
         <involvedResources href="#resource_014" label="Cash" type="straight"/>
         <involvedResources href="#resource_029" label="Milk for Processing" type="straight"/>
         <involvedResources href="#resource_070" label="Milk for Consumption" type="straight"/>
         <dependsOnParameters href="#property_146" label="dairy milk Proportion" type="straight"/>
         <dependsOnParameters href="#property_119" label="Market Price (Raw Milk)" type="straight"/>
         <affectsResources href="#resource_071" label="Milk sale" type="straight"/>
         <affectsResources href="#resource_067" label="Livestock_revenue" type="straight"/>
         <affectsResources href="#resource_029" label="Milk for Processing" type="straight"/>
         <source href="#agent_005" label="Household" type="straight"/>
         <destination href="#agent_013" label="Market" type="straight"/>
    </processes>

    <processes xsi:type="ses:TransformationProcess" xmi:id="process_031" id="process_031" name="milk_processing_dairy" description="Conversion of raw milk input into final dairy products." comment="Consumes raw milk (resource_060) from the AgroPastoralHouseholds and produces processed dairy product stock (resource_061) based on efficiency." pos_x="200.0" pos_y="2250.0" width="150.0" height="60.0" equation="ProductOutput = MilkForProcessing * ProcessingEfficiency" pseudoCode="
      // Get raw milk input
      raw_milk_input = milk_for_processing /* resource_029 */;
      processing_efficiency = dairy_processing_efficiency /* property_117 */;

      if (raw_milk_input &gt; 0) {
        // Calculate final product output
        product_output = raw_milk_input * processing_efficiency;

        // 1. Consume raw milk input
        milk_for_processing = milk_for_processing - raw_milk_input; /* resource_029 */

        // 2. Increase final product stock
        Dairy_Product_Stock = Dairy_Product_Stock + product_output; /* resource_026 */
      }
      else {
        product_output = 0;
      }" transformationType="Modification">
      <subjects href="#agent_023" label="Dairy" type="straight"/>
      <objects href="#agent_023" label="Dairy" type="straight"/> 
      <involvedResources href="#resource_029" label="Milk for Processing" type="straight"/>
      <dependsOnParameters href="#property_117" label="Dairy Processing Efficiency" type="straight"/>
      <affectsResources href="#resource_029" label="Milk for Processing" type="straight"/>
      <affectsResources href="#resource_026" label="Dairy Product Stock" type="straight"/>
    </processes>
    
    <processes xsi:type="ses:MovementProcess" xmi:id="process_032" id="process_032" name="dairy_product_sale" description="Sale of processed dairy products at market, tracking cumulative volume sold." comment="Consumes Dairy Product Stock (resource_061) and records the total mass sold into a cumulative metric (resource_062)." pos_x="200.0" pos_y="2450.0" width="150.0" height="60.0" equation="DairySoldCum += DairyProductStock; DeltaStock = -DairyProductStock" pseudoCode="
      // Quantity to sell is the current stock
      to_sell = processed_meat_stock /* resource_058 */;
      market_price = market_price_meat /* property_030 */;

      // Decision: Sell if there is stock available
      if (to_sell &gt; 0) {
        // Calculate revenue (The financial transaction is abstracted away, but revenue is calculated for context)
        revenue = to_sell * market_price;
        
        // Execute transaction: Decrease Stock and Update Cumulative Metric
        
        // 1. Decrease Stock (consumed/sold)
        processed_meat_stock /* resource_058 */ = processed_meat_stock - to_sell; 
        
        // 2. Update Cumulative Meat Sold Amount
        Meat_Sold_Amount_Cumulative /* resource_061 */ = Meat_Sold_Amount_Cumulative + to_sell;
      } else {
        // No stock to sell, no change
        revenue = 0;
      }">
          <subjects href="#agent_023" label="Dairy" type="straight"/>
          <objects href="#agent_013" label="Market" type="straight"/>
          <involvedResources href="#resource_026" label="Dairy Product Stock" type="straight"/>
          <involvedResources href="#resource_062" label="Dairy Product Sold Amount (Cumulative)" type="straight"/>
