    <processes xsi:type="ses:TransformationProcess" xmi:id="process_070" id="process_070" name="off_farm_employment" description="Generates off-farm income for the household based on allocated labor and the market wage rate, considering the inverse relationship with farm size/viability." comment="This process models the active engagement in non-agricultural livelihood strategies. The Household Off-Farm Strategy (property_132) should be dynamically set, often increasing when Crop Area (property_065) is small, reflecting the findings that smaller farms diversify more." pos_x="-1600.0" pos_y="300.0" width="180.0" height="70.0" equation="\Delta \text{OffFarmIncome} = \text{AllocatedLabor} \times \text{WageRate}" pseudoCode="
      // Household strategic decision: Define fraction of available labor to allocate
      // Logic Check: In a robust model, the decision (property_132) is a function of Farm Size (resource_065), 
      // e.g., Strategy_Rate = Max_Rate * f(1 / Crop_Area).
      labor_allocation_rate = household_offFarm_strategy /* property_132 */;

      // 1. Calculate Labor Used
      available_labor_tmp = available_labor /* resource_064 */;
      allocated_labor = available_labor_tmp * labor_allocation_rate;

      // 2. Calculate Income Generated
      wage_rate = off_farm_wage_rate /* property_131 */;
      offFarm_income_generated = allocated_labor * wage_rate;

      // 3. Update Resources (Mass Balance)
      // Store the generated income in the dedicated resource
      off_farm_income /* resource_066 */ = off_farm_income + offFarm_income_generated;

      // Consume the allocated labor (Mass Balance)
      available_labor /* resource_064 */ = available_labor - allocated_labor;" transformationType="Modification">
          <subjects href="#agent_005" label="Agro-Pastoral Households" type="straight"/>
          <objects href="#agent_005" label="Agro-Pastoral Households" type="straight"/>
          <involvedResources href="#resource_064" label="Available Labor" type="straight"/>
          <involvedResources href="#resource_066" label="Off-Farm Income" type="straight"/>
          <involvedResources href="#resource_065" label="Crop Area" type="straight"/> 
          <dependsOnParameters href="#property_131" label="Off-Farm Wage Rate" type="straight"/>
          <dependsOnParameters href="#property_132" label="Household Off-Farm Strategy" type="straight"/>      
          <affectsResources href="#resource_064" label="Available Labor" type="straight"/>
          <affectsResources href="#resource_066" label="Off-Farm Income" type="straight"/>
    </processes>

    <processes xsi:type="ses:TransformationProcess" xmi:id="process_019" id="process_019" name="income_diversification" description="Consolidation of various revenue streams (livestock, crops, off-farm, nonfarm) to model household resilience and update cash reserves. This process represents the inflow of money from diversified sources." comment="This process sums revenue outputs from specific sales and off-farm/nonfarm sources. The act of diversification increases the household's Resilience status (a hidden agent property) as it reduces reliance on a single income source." pos_x="-1343.6799999999998" pos_y="-617.1199999999998" width="170.0" height="60.0" equation="\Delta Cash = \sum (\text{Revenue Streams})" pseudoCode="
      // Step 1: Define Income Streams (Assumed outputs from previous processes)
      livestock_revenue_tmp = livestock_revenue /* resource_067 */;
      crop_revenue_tmp = crop_sale_revenue /* resource_068 */;
      nonfarm_offfarm_income = off_farm_income /* resource_066 */;

      current_cash = cash /* resource_014 */;

      // Step 2: Calculate Total Income Consolidated (Mass Balance)
      total_diversified_income = livestock_revenue_tmp + crop_revenue_tmp + nonfarm_offfarm_income;

      // Step 3: Update Resources (Cash Inflow and Resource Reset)
      cash /* resource_014 */ = cash + total_diversified_income;

      livestock_revenue /* resource_067 */ = livestock_revenue - livestock_revenue_tmp;
      crop_sale_revenue /* resource_068 */ = crop_sale_revenue - crop_revenue_tmp;
      off_farm_income /* resource_066 */ = off_farm_income - nonfarm_offfarm_income;

      // Step 4: Update Resilience Property (Qualitative Outcome - Essential for Realism)
      // The Resilience Index increases based on the number of active, non-zero revenue streams.
      active_streams = 0;
      if (livestock_revenue_tmp &gt; 0) { 
        active_streams = active_streams + 1; 
      }
      if (crop_revenue_tmp &gt; 0) { 
        active_streams = active_streams + 1; 
      }
      if (nonfarm_offfarm_income &gt; 0) { 
        active_streams = active_streams + 1; 
      }

      // Placeholder for the resilience function (to be defined precisely later)
      Resilience_Index = Resilience_Index + f(active_streams, relative_magnitude); 
      // Note: For example, combining Farm + Off-Farm yields a specific, statistically significant improvement in security." transformationType="Modification">
          <subjects href="#agent_005" label="AgroPastoralHouseholds" type="straight"/>
          <objects href="#agent_005" label="AgroPastoralHouseholds" type="straight"/>
          <involvedResources href="#resource_014" label="Cash" type="straight"/>
          <involvedResources href="#resource_066" label="Off-Farm Income" type="straight"/>
          <involvedResources href="#resource_067" label="Livestock Revenue" type="straight"/>    
          <involvedResources href="#resource_068" label="Crop Sale Revenue" type="straight"/> 
          <affectsResources href="#resource_014" label="Cash" type="straight"/>
          <affectsResources href="#resource_066" label="Off-Farm Income" type="straight"/>
          <affectsResources href="#resource_067" label="Animal Sale Revenue" type="straight"/>
          <affectsResources href="#resource_068" label="Crop Sale Revenue" type="straight"/>
    </processes>

    <processes xsi:type="ses:TransformationProcess" xmi:id="process_018" id="process_018" name="conflict_resolution" description="Sequential management of resource conflicts (Water, Fodder) beginning with informal, knowledge-based mediation before involving formal institutions. The successful outcome restores full access to the disputed resources by setting the Conflict Penalty Factor to zero." comment="The resolution process removes the penalty on the effective availability of Water and Fodder resources that occurs during active conflict." pos_x="-1232.192000000001" pos_y="1716.1919999999993" width="160.0" height="60.0" equation="\text{ProbResolution} = f(\text{TraditionalKnowledge}, \text{GovernanceEfficiency})" pseudoCode="
      if (conflict_detected) {
        // 1. Tentative de résolution informelle
        ProbInformal = traditional_knowledge * informal_mediation_factor /* property_134 */;
        
        if (random &lt; ProbInformal) {
          conflict_resolved = true;
        } else {
          // 2. Escalade vers résolution formelle
          ProbFormal = governance_efficiency /* property_133 */;
          
          if (random &lt; ProbFormal) {
            conflict_resolved = true;
          } else {
            conflict_resolved = false;
          }
        }
        
        // 3. Application du résultat sur les ressources
        if (conflict_resolved) {
          conflict_penalty_water = 0.0 /* property_164 */;              
          conflict_penalty_seasonal_fodder = 0.0 /* property_165 */;    
        } else {
          conflict_penalty_water = 0.5;              
          conflict_penalty_seasonal_fodder = 0.5;
        }
      } 
      // Fin du bloc de conflit" transformationType="Modification">
          <subjects href="#agent_014" label="Governmental Institutions" type="straight"/>
          <objects href="#agent_005" label="Agro-Pastoral Households" type="straight"/>
          <involvedResources href="#resource_042" label="Water" type="straight"/>
          <involvedResources href="#resource_041" label="Seasonal Fodder" type="straight"/>
          <involvedResources href="#resource_044" label="Traditional Knowledge" type="straight"/>
          <dependsOnParameters href="#property_133" label="Governance Efficiency" type="straight"/>
          <dependsOnParameters href="#property_134" label="Informal Mediation Factor" type="straight"/> 
          <dependsOnParameters href="#property_164" label="conflict_penalty_water" type="straight"/>
          <dependsOnParameters href="#property_165" label="conflict_penalty_seasonal_fodder" type="straight"/>
          <affectsResources href="#resource_042" label="Water" type="straight"/>
          <affectsResources href="#resource_041" label="Seasonal Fodder" type="straight"/>
    </processes>



    <processes xsi:type="ses:TransformationProcess" xmi:id="process_020" id="process_020" name="biodiversity_conservation" description="Manages the state of the Biodiversity resource, recognizing that moderate grazing is beneficial, but excessive pressure causes degradation linked to soil erosion risk." comment="Models a tripartite relationship between Grazing Pressure, a beneficial Optimal Threshold, and a detrimental Degradation Threshold, linking severe overgrazing to loss of Soil Nitrogen." pos_x="747.448" pos_y="-961.728" width="160.0" height="60.0" equation="\Delta \text{Biod} = f(\text{GrazingPressure}, \text{Thresholds})" pseudoCode="
      // 1. Define Parameters and Inputs
      // (Assuming Total_Grazing_Area is a known parameter or aggregate of Grasslands/Rangelands area)
      herd_tlu_tmp = herd_tlu /* resource_069 */;
      grazing_pressure = herd_tlu_tmp / total_grazing_area;

      degradation_threshold = sustain_graz_threshold /* property_098 */;
      optimal_threshold = sustain_graz_threshold /* property_137 */;

      // 2. Determine Biodiversity Change (Three Regimes for Realism)
      if (grazing_pressure &lt; optimal_threshold) {
        // Regime 1: Under-grazing or Light Grazing (Sub-optimal growth, as grazing is necessary)
        change = biodiversity_growth_rate /* property_135 */;
        soil_loss = 0;
      } else if (grazing_pressure &lt;= degradation_threshold) {
        // Regime 2: Optimal to Sustainable Grazing (Growth maximized/maintained)
        change = biodiversity_growth_rate /* property_135 */;
        soil_loss = 0;
      } else {
        // Regime 3: Over-grazing (Degradation occurs, leading to erosion risk)
        degradation_intensity = grazing_pressure - degradation_threshold;
        change = degradation_intensity * grazing_degradation_factor /* property_136 */;
        
        // Secondary effect: Link to Soil Erosion Factor (property_144) and loss of Soil Nitrogen
        soil_loss = degradation_intensity * soil_erosion_factor /* property_144 */;
      }

      // 3. Update Resources (Mass Balance)
      // Update Biodiversity (resource_043 assumed)
      biodiversity /* resource_043 */ = biodiversity + change;
      biodiversity /* resource_043 */ = max(0.0, min(1.0, biodiversity)); /* resource_043 */

      // Link degradation to soil nutrient loss
      soil_nitrogen /* resource_001 */ = soil_nitrogen - soil_loss;" transformationType="Modification">
         <subjects href="#agent_005" label="Agro-Pastoral Households" type="straight"/> 
         <objects href="#agent_015" label="Biodiversity" type="straight"/> 
