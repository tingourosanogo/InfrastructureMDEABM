    <properties xsi:type="ses:Parameter" xmi:id="property_065" id="property_065" name="milk_production_need" description="Milk Production Need" comment="Need for milk production based on animal health and lactation" pos_x="3700.0" pos_y="1400.0" width="168.0" height="45.0" unit="index" value="0.0" isExogenous="false" parameterType="Behavioral"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_066" id="property_066" name="application_rate" description="Application Rate" comment="Rate of application for fertilizers and other inputs" pos_x="3900.0" pos_y="1400.0" width="168.0" height="45.0" unit="kg/ha/step" value="0.0" isExogenous="false" parameterType="Physical"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_067" id="property_067" name="offtake_young_male" description="Offtake Young Male" pos_x="343.56" pos_y="2449.64" width="168.0" height="45.0" unit="proportion/step" value="0.0" isExogenous="false" parameterType="float"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_068" id="property_068" name="offtake_young_female" description="Offtake Young Female" pos_x="503.56" pos_y="2529.64" width="168.0" height="45.0" unit="proportion/step" value="0.0" isExogenous="false" parameterType="float"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_069" id="property_069" name="offtake_sub_adult_male" description="Offtake Sub-Adult Male" pos_x="663.56" pos_y="2609.64" width="168.0" height="45.0" unit="proportion/step" value="0.0" isExogenous="false" parameterType="float"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_070" id="property_070" name="base_milk_yield" description="Average milk yield (L/day/animal) under optimal conditions." comment="Replaces resource_039 as a dependency." pos_x="1000.0" pos_y="3500.0" width="168.0" height="45.0" unit="L/animal/day" value="3.5" parameterType="Biological"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_071" id="property_071" name="total_lactation_period" description="The total number of days in the lactation cycle." comment="Used to calculate the lactation stage factor." pos_x="1000.0" pos_y="3800.0" width="168.0" height="45.0" unit="days" value="300" parameterType="Biological"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_072" id="property_072" name="fodder_regrowth_rate" description="Fodder Regrowth Rate" pos_x="1143.56" pos_y="2849.64" width="168.0" height="45.0" unit="kgDM/m²/step" value="0.0" isExogenous="false" parameterType="Physical"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_073" id="property_073" name="maximum_grazing_capacity" description="Maximum Grazing Capacity" pos_x="1303.56" pos_y="2929.64" width="200.0" height="45.0" unit="TLU/ha" value="0.0" isExogenous="false" parameterType="Physical"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_074" id="property_074" name="fodder_decay_rate" description="Fodder Decay Rate" pos_x="1463.56" pos_y="3009.64" width="168.0" height="45.0" unit="proportion/step" value="0.0" isExogenous="false" parameterType="Physical"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_075" id="property_075" name="young_female_mortality_rate" description="Young Female Mortality Rate" comment="Proportion of young females that die each year" pos_x="598.888" pos_y="1902.3679999999997" width="168.0" height="45.0" unit="proportion/step" value="0.0" isExogenous="false" parameterType="Biological"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_076" id="property_076" name="sub_adult_male_mortality_rate" description="Sub-Adult Male Mortality Rate" comment="Proportion of sub-adult males that die each year" pos_x="819.7919999999999" pos_y="1963.0159999999998" width="168.0" height="45.0" unit="proportion/step" value="0.0" isExogenous="false" parameterType="Biological"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_077" id="property_077" name="sub_adult_female_mortality_rate" description="Sub-Adult Female Mortality Rate" comment="Proportion of sub-adult females that die each year" pos_x="1000.032" pos_y="1922.4799999999998" width="168.0" height="45.0" unit="proportion/step" value="0.0" isExogenous="false" parameterType="Biological"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_078" id="property_078" name="adult_male_mortality_rate" description="Adult Male Mortality Rate" comment="Proportion of adult males that die each year" pos_x="1099.592" pos_y="1863.3919999999998" width="168.0" height="45.0" unit="proportion/step" value="0.0" isExogenous="false" parameterType="Biological"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_079" id="property_079" name="adult_female_mortality_rate" description="Adult Female Mortality Rate" comment="Proportion of adult females that die each year" pos_x="1200.152" pos_y="1804.304" width="168.0" height="45.0" unit="proportion/step" value="0.0" isExogenous="false" parameterType="Biological"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_080" id="property_080" name="feces_nutrient_proportion" description="The fraction of non-absorbed (excreted) nutrients that is expelled as feces." comment="Must sum with Urine Nutrient Proportion to 1.0" pos_x="1000.0" pos_y="2600.0" width="168.0" height="45.0" unit="proportion" value="0.75" isExogenous="false" parameterType="Biological"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_081" id="property_081" name="min_moisture" description="Minimum soil moisture (fraction) required for application." comment="Used in process_004." pos_x="1000.0" pos_y="5000.0" unit="proportion" value="0.10" isExogenous="false" parameterType="Physical"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_082" id="property_082" name="urine_nutrient_proportion" description="The fraction of non-absorbed (excreted) nutrients that is expelled as urine." comment="Must sum with Feces Nutrient Proportion to 1.0" pos_x="1000.0" pos_y="2700.0" width="168.0" height="45.0" unit="proportion" value="0.25" isExogenous="false" parameterType="Biological"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_083" id="property_083" name="cultivated_litter_to_n" description="The proportional mass of Nitrogen (N) content in a unit of Cultivated Litter." comment="Used in process_001 to calculate N contribution from crop residues." pos_x="1000.0" pos_y="4700.0" width="168.0" height="45.0" unit="kgN/kgDM" value="0.01" isExogenous="false" parameterType="Physical"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_084" id="property_084" name="manure_to_c" description="The proportional mass of Carbon (C) content in a unit of Manure." comment="Used in process_001" pos_x="1000.0" pos_y="4400.0" width="168.0" height="45.0" unit="kgC/kgDM" value="0.2" isExogenous="false" parameterType="Physical"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_085" id="property_085" name="manure_to_n" description="The proportional mass of Nitrogen (N) content in a unit of Manure." comment="Used in process_001" pos_x="1000.0" pos_y="4500.0" width="168.0" height="45.0" unit="kgN/kgDM" value="0.015" isExogenous="false" parameterType="Physical"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_086" id="property_086" name="base_absorption_rate" description="The base efficiency of nutrient absorption in a healthy, average-condition animal (before health/condition modifiers)." comment="Determines the maximum potential absorption rate" pos_x="1000.0" pos_y="2800.0" unit="proportion" value="0.80" isExogenous="false" parameterType="Biological"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_087" id="property_087" name="max_nitrogen" description="The maximum mineral Nitrogen (kg) the soil can effectively hold/absorb." comment="Used in process_004 to cap the Soil Nitrogen resource." pos_x="-1400.0" pos_y="-200.0" width="168.0" height="45.0" unit="kgN/ha" value="100.0" isExogenous="false" parameterType="Physical"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_088" id="property_088" name="base_efficiency" description="The inherent application efficiency (proportion) under ideal conditions (e.g., 0.6)." comment="Base efficiency used in process_004." pos_x="-1300.0" pos_y="-300.0" width="168.0" height="45.0" unit="proportion" value="0.65" isExogenous="false" parameterType="Physical"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_089" id="property_089" name="optimal_moisture" description="Soil moisture (fraction) for maximum fertilizer efficiency." comment="Used in process_004." pos_x="-1200.0" pos_y="-400.0" width="168.0" height="45.0" unit="proportion" value="0.30" isExogenous="false" parameterType="Physical"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_090" id="property_090" name="min_yield_threshold" description="Minimum Yield Threshold" comment="Minimum yield threshold for economic viability" pos_x="-1100.0" pos_y="-500.0" width="168.0" height="45.0" unit="kgDM/ha" value="0.0" isExogenous="false" parameterType="Physical"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_091" id="property_091" name="max_yield_threshold" description="Maximum Yield Threshold" comment="Maximum yield threshold for economic viability" pos_x="-1000.0" pos_y="-600.0" width="168.0" height="45.0" unit="kgDM/ha" value="0.0" isExogenous="false" parameterType="Physical"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_092" id="property_092" name="trimming_efficiency" description="The proportional weight retained after removing external fat/waste during trimming (0 to 1)." comment="Used in process_015" pos_x="1000.0" pos_y="3100.0" width="168.0" height="45.0" unit="proportion" value="0.95" isExogenous="false" parameterType="Behavioral"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_093" id="property_093" name="cutting_efficiency" description="The proportional weight retained after bone/excess cutting waste (0 to 1)." comment="Used in process_015" pos_x="1000.0" pos_y="3200.0" width="168.0" height="45.0" unit="proportion" value="0.98" isExogenous="false" parameterType="Behavioral"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_094" id="property_094" name="packaging_loss" description="The proportional weight lost during packaging due to moisture/handling (0 to 1)." comment="Used in process_015" pos_x="1000.0" pos_y="3300.0" width="168.0" height="45.0" unit="proportion" value="0.01" isExogenous="false" parameterType="Physical"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_095" id="property_095" name="storage_loss" description="The proportional weight lost during cold storage (0 to 1)." comment="Used in process_015" pos_x="1000.0" pos_y="3400.0" width="168.0" height="45.0" unit="proportion" value="0.005" isExogenous="false" parameterType="Physical"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_096" id="property_096" name="herbaceous_n_uptake_ratio" description="Nitrogen uptake ratio by herbaceous" comment="Ratio of nitrogen uptake by herbaceous" pos_x="4800.0" pos_y="1400.0" width="168.0" height="45.0" unit="kgN/kgDM" value="0.0" isExogenous="false" parameterType="Physical"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_097" id="property_097" name="n_opt" description="Optimal soil nitrogen for plant growth" pos_x="400.0" pos_y="-200.0" width="168.0" height="45.0" unit="kgN/ha" value="10.0" isExogenous="false" parameterType="Physical"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_098" id="property_098" name="season" description="season" pos_x="400.0" pos_y="-300.0" width="168.0" height="45.0" unit="dimensionless" value="0.0" isExogenous="false" parameterType="Physical"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_099" id="property_099" name="temp_opt" description="Optimal Temperature" pos_x="500.0" pos_y="-200.0" width="168.0" height="45.0" unit="°C" value="0.0" isExogenous="false" parameterType="Physical"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_100" id="property_100" name="min_herd_condition" description="Minimum herd body condition index required for undertaking long-distance migration." comment="Threshold to prevent excessive mortality during movement" pos_x="1000.0" pos_y="1900.0" width="168.0" height="45.0" unit="index" value="2.0" parameterType="Biological"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_101" id="property_101" name="sex_ratio" description="Proportion of male offspring at birth (Male Count / Total Births)." comment="Often assumed 0.5 for livestock" pos_x="1000.0" pos_y="2000.0" width="168.0" height="45.0" unit="proportion" value="0.5" parameterType="Biological"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_102" id="property_102" name="young_female_min_age" description="Minimum age (in years/steps) for female animals to transition out of the young class." comment="Typically, the end of the calf stage" pos_x="1000.0" pos_y="2100.0" width="168.0" height="45.0" unit="years" value="1.0" parameterType="Biological"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_103" id="property_103" name="young_female_max_age" description="Maximum age (in years/steps) for female animals to transition out of the young class." comment="Defines the upper bound of the young class duration" pos_x="1000.0" pos_y="2200.0" width="168.0" height="45.0" unit="years" value="2.0" parameterType="Biological"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_104" id="property_104" name="sub_adult_age_duration" description="The duration (in years/steps) an animal spends in the sub-adult class before transitioning to the adult class." comment="Typically, 1 to 3 years depending on species/breed" pos_x="1000.0" pos_y="2300.0" width="168.0" height="45.0" unit="years" value="2.0" parameterType="Biological"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_105" id="property_105" name="manure_deposition_rate" description="Fraction of raw excreted waste (faeces + urine) that is effectively deposited and contributes to the Manure resource, accounting for losses like volatilization." comment="Value between 0 and 1" pos_x="1000.0" pos_y="2400.0" width="168.0" height="45.0" unit="proportion" value="0.75" parameterType="Biological"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_106" id="property_106" name="feed_nutrient_content" description="The average nutrient/energy density of the total consumed feed mix (DM, Hay, Concentrate, Residue)." comment="Used to convert mass intake (DMI) to nutrient mass for absorption modeling" pos_x="1000.0" pos_y="2500.0" width="168.0" height="45.0" unit="MJ/kgDM" value="0.5" parameterType="Biological"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_107" id="property_107" name="live_animal_price" description="The average price received per animal (or per unit of weight) sold to the market/slaughterhouse." comment="Used to calculate revenue from animal sales" pos_x="1000.0" pos_y="2900.0" width="168.0" height="45.0" unit="currency/animal" value="250.0" parameterType="Commercial"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_108" id="property_108" name="slaughter_prop_young_male" description="Fraction of Young Males sold that are destined for the slaughterhouse." comment="Value between 0 and 1" pos_x="1000.0" pos_y="3000.0" width="168.0" height="45.0" unit="proportion" value="0.70" parameterType="Commercial"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_109" id="property_109" name="slaughter_prop_young_female" description="Fraction of Young Females sold that are destined for the slaughterhouse." comment="Value between 0 and 1" pos_x="1000.0" pos_y="3100.0" width="168.0" height="45.0" unit="proportion" value="0.70" parameterType="Commercial"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_110" id="property_110" name="slaughter_prop_sub_adult_male" description="Fraction of Sub-Adult Males sold that are destined for the slaughterhouse." comment="Value between 0 and 1" pos_x="1000.0" pos_y="3200.0" width="168.0" height="45.0" unit="proportion" value="0.80" parameterType="Commercial"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_111" id="property_111" name="slaughter_prop_sub_adult_female" description="Fraction of Sub-Adult Females sold that are destined for the slaughterhouse." comment="Value between 0 and 1" pos_x="1000.0" pos_y="3300.0" width="168.0" height="45.0" unit="proportion" value="0.75" parameterType="Commercial"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_112" id="property_112" name="slaughter_prop_adult_male" description="Fraction of Adult Males sold that are destined for the slaughterhouse." comment="Value between 0 and 1" pos_x="1000.0" pos_y="3400.0" width="168.0" height="45.0" unit="proportion" value="0.9" parameterType="Commercial"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_113" id="property_113" name="slaughter_prop_adult_female" description="Fraction of Adult Females sold that are destined for the slaughterhouse." comment="Value between 0 and 1" pos_x="1000.0" pos_y="3500.0" width="168.0" height="45.0" unit="proportion" value="0.85" parameterType="Commercial"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_114" id="property_114" name="optimal_condition" description="The Body Condition Score (BCS) value representing optimal health and body reserves, used as a reference for carcass yield and stress calculation." comment="Often set to 1.0 if BCS is normalized to 0-1 range" pos_x="1000.0" pos_y="3000.0" width="168.0" height="45.0" unit="BCS" value="1.0" parameterType="Biological"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_115" id="property_115" name="lactating_proportion" description="The average proportion of Adult Female Count that is currently lactating." comment="Used in process_005 to estimate the number of milk-producing animals." pos_x="1000.0" pos_y="3900.0" width="168.0" height="45.0" unit="proportion" value="0.75" parameterType="Biological"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_116" id="property_116" name="days_lactation_avg" description="The average number of days the lactating females in the herd have been in milk." comment="Used in process_005 to calculate the lactation stage factor." pos_x="1000.0" pos_y="4000.0" width="168.0" height="45.0" unit="days" value="150" parameterType="Biological"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_117" id="property_117" name="dairy_processing_efficiency" description="The proportional conversion rate of raw milk volume to final processed product mass/volume (0 to 1), accounting for losses and conversion ratio." comment="Used in process_031." pos_x="1000.0" pos_y="4200.0" width="168.0" height="45.0" unit="proportion" value="0.9" parameterType="Biological"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_118" id="property_118" name="market_price_dairy_product" description="The market price per unit (kg or L) of the final processed dairy product stock." comment="Used in process_032 to calculate revenue/value of sold dairy products (if Cash tracking were included)." pos_x="1000.0" pos_y="4300.0" width="168.0" height="45.0" unit="currency/kg" value="4.0" isExogenous="true" parameterType="Economic"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_119" id="property_119" name="market_price_raw_milk" description="The market price per unit (kg or L) of the milk." comment="Used in process_021 to calculate revenue/value of milk by AgroPastoralHouseholds." pos_x="1000.0" pos_y="4300.0" width="168.0" height="45.0" unit="currency/L" value="4.0" isExogenous="true" parameterType="Economic"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_120" id="property_120" name="crop_yield_rate_r_max" description="Maximum intrinsic proportional growth rate of crop biomass per season." comment="Used in process_034" pos_x="1000.0" pos_y="5400.0" width="168.0" height="45.0" unit="1/step" value="0.1" parameterType="Biological"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_121" id="property_121" name="harvest_index" description="Proportion of total crop biomass that is marketable grain/yield." comment="Used in process_034 (0.3-0.5)" pos_x="1000.0" pos_y="5500.0" width="168.0" height="45.0" unit="proportion" value="0.4" parameterType="Biological"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_122" id="property_122" name="residue_n_content" description="Proportional mass of Nitrogen (N) in the crop residue left after harvest." comment="Used in process_034 for N mass balance" pos_x="1000.0" pos_y="5600.0" width="168.0" height="45.0" unit="kgN/kgDM" value="0.01" parameterType="Biological"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_124" id="property_124" name="residue_grazing_prop" description="Proportion of crop residue consumed by animals after harvest." comment="Used in process_035" pos_x="1000.0" pos_y="5900.0" width="168.0" height="45.0" unit="proportion" value="0.4" parameterType="Physical"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_125" id="property_125" name="residue_incorp_prop" description="Proportion of crop residue incorporated into the soil (Cultivated Litter)." comment="Used in process_035" pos_x="1000.0" pos_y="6000.0" width="168.0" height="45.0" unit="proportion" value="0.6" parameterType="Physical"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_126" id="property_126" name="hay_conservation_rate" description="The proportional amount of Seasonal Fodder allocated for haymaking and storage (typically run at the end of the season)." comment="Used in process_036" pos_x="1000.0" pos_y="6100.0" width="168.0" height="45.0" unit="proportion" value="0.1" parameterType="Biological"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_127" id="property_127" name="hay_efficiency" description="The proportional mass retained after accounting for harvesting, drying, and storage losses." comment="Used in process_036 (0.6 - 0.8)" pos_x="1000.0" pos_y="6200.0" width="168.0" height="45.0" unit="proportion" value="0.7" parameterType="Biological"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_128" id="property_128" name="haymaking_labor_req_rate" description="Labor units required per kilogram of fodder allocated for haymaking." comment="Used in process_036 to constrain production based on labor availability." pos_x="1000.0" pos_y="6300.0" unit="man-day/kgDM" value="0.01" parameterType="Biological"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_129" id="property_129" name="crop_market_price" description="The price of crop yield per unit mass (e.g., currency/kg) on the market." comment="External economic parameter influencing Crop Sale Revenue." pos_x="-1600.0" pos_y="-100.0" width="168.0" height="45.0" unit="currency/kg" value="4.0" isExogenous="true" parameterType="Economic"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_130" id="property_130" name="crop_sale_proportion" description="The fractional decision (0-1) by the Agro-Pastoral Households on how much of the Crop Yield to sell." comment="Strategic household decision parameter used in the crop_sale process (process_071)." pos_x="-1600.0" pos_y="-50.0" width="168.0" height="45.0" unit="proportion" value="0.4" isExogenous="true" parameterType="Economic"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_131" id="property_131" name="off_farm_wage_rate" description="The price paid per unit of labor (e.g., currency/man-day) for off-farm employment." comment="External economic parameter used in the off_farm_employment process (process_070)." pos_x="-1600.0" pos_y="100.0" width="168.0" height="45.0" unit="currency/man-day" value="4.0" isExogenous="true" parameterType="Economic"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_132" id="property_132" name="household_offFarm_strategy" description="The fractional decision (0-1) by the Agro-Pastoral Households on labor allocation for off-farm activities." comment="Strategic household decision parameter used in the off_farm_employment process (process_070). This value typically increases for smaller, less viable farms." pos_x="-1600.0" pos_y="150.0" width="168.0" height="45.0" unit="proportion" value="0.4" isExogenous="true" parameterType="Economic"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_133" id="property_133" name="governance_efficiency" description="The effectiveness (0-1) of Governmental Institutions (agent_014) in resolving resource conflicts." comment="Used in process_018 for the probability of formal conflict resolution." pos_x="-1400.0" pos_y="1700.0" width="168.0" height="45.0" unit="index" value="0.0" isExogenous="true" parameterType="Social"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_134" id="property_134" name="informal_mediation_factor" description="The intrinsic effectiveness (0-1) of local, informal mechanisms (social norms) for conflict resolution, based on Traditional Knowledge." comment="Used in process_018 for the probability of informal conflict resolution." pos_x="-1400.0" pos_y="1750.0" width="168.0" height="45.0" unit="index" value="0.0" isExogenous="true" parameterType="Social"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_135" id="property_135" name="biodiversity_growth_rate" description="The maximum natural or assisted rate of recovery for the Biodiversity resource." comment="Ecological parameter used in the biodiversity_conservation process (process_020)." pos_x="700.0" pos_y="-1000.0" width="168.0" height="45.0" unit="1/step" value="0.0" isExogenous="true" parameterType="Ecological"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_136" id="property_136" name="grazing_degradation_actor" description="The sensitivity coefficient determining how much biodiversity is lost per unit of excessive grazing pressure." comment="Ecological parameter used in the biodiversity_conservation process (process_020)." pos_x="700.0" pos_y="-950.0" width="168.0" height="45.0" unit="1/TLU" value="0.0" isExogenous="true" parameterType="Ecological"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_137" id="property_137" name="sustain_graz_threshold" description="The maximum TLU/Area ratio the ecosystem can sustain before degradation begins (Biodiversity Index decreases)." comment="Ecological parameter used in the biodiversity_conservation process (process_020)." pos_x="700.0" pos_y="-900.0" width="168.0" height="45.0" unit="TLU/ha" value="0.0" isExogenous="true" parameterType="Ecological"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_138" id="property_138" name="tlu_rate_young_male" description="The conversion factor for one unit of young_male stock into TLU (e.g., 0.25 TLU/head)." comment="Used in process_072." pos_x="-1400.0" pos_y="600.0" unit="TLU/head" value="1.0" parameterType="Biological"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_139" id="property_139" name="tlu_rate_young_female" description="The conversion factor for one unit of young_female stock into TLU (e.g., 0.25 TLU/head)." comment="Used in process_072." pos_x="-1400.0" pos_y="650.0" unit="TLU/head" value="1.0" parameterType="Biological"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_140" id="property_140" name="tlu_rate_sub_adult_male" description="The conversion factor for one unit of sub_adult_male stock into TLU (e.g., 0.50 TLU/head)." comment="Used in process_072." pos_x="-1400.0" pos_y="700.0" unit="TLU/head" value="1.0" parameterType="Biological"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_141" id="property_141" name="tlu_rate_sub_adult_female" description="The conversion factor for one unit of sub_adult_female stock into TLU (e.g., 0.50 TLU/head)." comment="Used in process_072." pos_x="-1400.0" pos_y="750.0" unit="TLU/head" value="1.0" parameterType="Biological"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_142" id="property_142" name="tlu_rate_adult_male" description="The conversion factor for one unit of adult_male stock into TLU (e.g., 0.75 TLU/head)." comment="Used in process_072." pos_x="-1400.0" pos_y="800.0" unit="TLU/head" value="1.0" parameterType="Biological"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_143" id="property_143" name="tlu_rate_adult_female" description="The conversion factor for one unit of adult_female stock into TLU (e.g., 0.75 TLU/head)." comment="Used in process_072." pos_x="-1400.0" pos_y="850.0" unit="TLU/head" value="1.0" parameterType="Biological"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_144" id="property_144" name="soil_erosion_factor" description="The coefficient determining the rate of Soil Nitrogen (resource_001) loss per unit of excessive grazing pressure." comment="Used in process_020 to link severe overgrazing to soil erosion risk, a requirement for sustainable grazing (Sustainable-grazing-Guideline-FINALpdf.pdf)." pos_x="700.0" pos_y="-800.0" unit="kgN/TLU/step" value="1.0" parameterType="Biological"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_145" id="property_145" name="milk_consumption_prop" description="The fractional decision (0-1) by the household on how much produced milk to consume." comment="Used in the milk_partitioning process (process_073)." pos_x="-600.0" pos_y="1650.0" unit="proportion" value="1.0" parameterType="Social"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_146" id="property_146" name="milk_dairy_prop" description="The fractional of sold milk for dairy" comment="The fractional of sold milk for dairy" pos_x="-600.0" pos_y="1650.0" unit="proportion" value="1.0" parameterType="Social"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_147" id="property_147" name="base_forage_yield" description="The maximum potential yield of the cultivated forage crop per unit area (e.g., kg/ha) under optimal conditions." comment="Used in process_075." pos_x="-900.0" pos_y="-100.0" unit="kgDM/ha" value="1.0" parameterType="Biological"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_148" id="property_148" name="forage_crop_area_prop" description="The strategic fractional decision (0-1) by the household to allocate a portion of the total Cropped Area (resource_038) to forage cultivation." comment="Used in process_075 as a strategic choice variable." pos_x="-900.0" pos_y="-50.0" unit="proportion" value="1.0" parameterType="Biological"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_149" id="property_149" name="labor_rate_forage" description="The labor (e.g., man-days) required to manage one unit of cultivated forage crop area (e.g., man-days/ha)." comment="Used in process_075." pos_x="-900.0" pos_y="0.0" unit="man-day/ha" value="1.0" parameterType="Biological"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_150" id="property_150" name="fertilization_eff_factor" description="The factor by which the potential yield of the forage crop is increased due to the application of fertilizer (technical input)." comment="Used in process_075." pos_x="-900.0" pos_y="50.0" unit="dimensionless" value="1.0" parameterType="Biological"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_151" id="property_151" name="fertilization_rate" description="The rate of fertilizer consumption per unit of area cultivated with forage (e.g., kg/ha)." comment="Used in process_075." pos_x="-900.0" pos_y="100.0" unit="kg/ha/step" value="0.0" parameterType="Biological"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_152" id="property_152" name="soil_quality_influence_factor" description="Scales the limiting effect of Soil Nitrogen (resource_001) on the final forage production." comment="Used in the rangeland_forage_production (process_074) and cultivated_forage_production (process_075) processes." pos_x="-900.0" pos_y="-300.0" unit="dimensionless" value="0.0" parameterType="Biological"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_153" id="property_153" name="rainfall_efficiency_factor" description="The coefficient converting rainfall volume (mm/unit area) into biomass volume (kg/unit area)." comment="Used in the rangeland_forage_production (process_074) and cultivated_forage_production (process_075) processes." pos_x="-900.0" pos_y="-350.0" unit="kgDM/mm" value="0.0" parameterType="Biological"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_154" id="property_154" name="harvest_efficiency_factor" description="The fractional rate (0-1) representing the efficiency of forage harvesting, accounting for field losses, shattering, and poor handling." comment="Used in cultivated_forage_production (process_075) to scale total production to final stock." pos_x="-900.0" pos_y="150.0" unit="proportion" value="0.0" parameterType="Biological"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_155" id="property_155" name="litter_proportion" description="Proportion of harvested forage crop stock that remains as litter/bedding." comment="e.g., 0.05" pos_x="10.0" pos_y="200.0" width="120.0" height="42.0" unit="proportion" value="0.05"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_156" id="property_156" name="hay_harvest_efficiency" description="Efficiency factor for converting harvested forage mass into final hay mass (accounts for drying/loss)." comment="e.g., 0.8" pos_x="10.0" pos_y="250.0" width="120.0" height="42.0" unit="proportion" value="0.8"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_157" id="property_157" name="health_recovery_rate" description="The rate at which Livestock Health improves per time step when conditions are favorable (e.g., intervention is successful)." comment="Default rate of 0.05" pos_x="400.0" pos_y="1600.0" width="120.0" height="42.0" unit="1/step" value="0.05"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_158" id="property_158" name="health_decline_rate" description="The rate at which Livestock Health declines per time step due to stressors (e.g., poor condition, climate stress)." comment="Default rate of 0.10" pos_x="400.0" pos_y="1650.0" width="120.0" height="42.0" unit="1/step" value="0.10"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_159" id="property_159" name="condition_recovery_rate" description="The rate at which Body Condition improves per time step when there is a feed surplus (Intake Ratio &gt; 1)." comment="Default rate of 0.08" pos_x="400.0" pos_y="1700.0" width="120.0" height="42.0" unit="1/step" value="0.08"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_160" id="property_160" name="condition_decline_rate" description="The rate at which Body Condition declines per time step when there is a feed deficit (Intake Ratio &lt; 1)." comment="Default rate of 0.15 (higher than recovery)" pos_x="400.0" pos_y="1750.0" width="120.0" height="42.0" unit="1/step" value="0.15"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_161" id="property_161" name="vet_service_access" description="Score (0 to 1) representing the ease and availability of veterinary care for the household." comment="PRAPS intervention variable." pos_x="400.0" pos_y="1800.0" width="120.0" height="42.0" unit="index" value="0.5"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_162" id="property_162" name="herd_vaccination_rate" description="Proportion of the herd that is covered by standard vaccination protocols (0 to 1)." comment="PRAPS intervention variable." pos_x="400.0" pos_y="1850.0" width="120.0" height="42.0" unit="proportion" value="0.5"/>   
    <properties xsi:type="ses:Parameter" xmi:id="property_163" id="property_163" name="intervention_efficacy" description="Technical effectiveness (0 to 1) of the available health interventions (drugs, vaccines, etc.)." comment="PRAPS intervention variable." pos_x="400.0" pos_y="1900.0" width="120.0" height="42.0" unit="dimensionless" value="0.75"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_164" id="property_164" name="conflict_penalty_water" description="Penalty applied to water availability during active conflict (0 to 1)." comment="" pos_x="-1200.0" pos_y="1760.0" width="120.0" height="42.0" unit="proportion" value="0.5" isExogenous="false" parameterType="Social"/>
    <properties xsi:type="ses:Parameter" xmi:id="property_165" id="property_165" name="conflict_penalty_seasonal_fodder" description="Penalty applied to seasonal fodder availability during active conflict (0 to 1)." comment="" pos_x="-1200.0" pos_y="1800.0" width="120.0" height="42.0" unit="proportion" value="0.5" isExogenous="false" parameterType="Social"/>
    


    <processes xsi:type="ses:TransformationProcess" xmi:id="process_001" id="process_001" name="mineralization" description="soil mineralization, converting organic matter (including manure) to enrich nitrogen/carbon" comment="Mineralization converts organic n/c from litter and manure stocks into mineral pools based on environmental conditions and organic content, with robustness checks to prevent negative organic stocks." pos_x="-983.4719999999999" pos_y="-946.3599999999999" width="120.0" height="60.0" equation="n_min = k_base * f(T) * f(θ) * f(pH) * (c/n) * SOM; n_input_total = sum(n_content * Stock)" pseudoCode="
      // Step 1: calculate Environmental Rate Factor (k) based on temp, moisture, pH, c/n ratio
      // Temperature effect  
      soil_temp = soil_temperature /* resource_063 */;
      temp_factor = exp(0.069 * (soil_temp - 10)); 
      if (temp_factor &lt; 0) {
        temp_factor = 0;
      }

      // Moisture effect 
      soil_moisture = soil_moisture /* resource_053 */; 
      field_capacity_tmp = field_capacity /* resource_005 */;
      moisture_factor = (soil_moisture / field_capacity_tmp);
      if (moisture_factor &gt; 1) {
        moisture_factor = 1;
      }
      if (moisture_factor &lt; 0.2) {
        moisture_factor = 0;
      }

      // pH effect
      soil_pH_tmp = soil_pH /* resource_052 */;
      ph_factor = min(1, max(0, (soil_pH_tmp - 4)/(7 - 4))); 

      // c/n ratio effect
      cn_ratio_tmp = cn_ratio /* property_032 */;
      cn_factor = min(1, max(0, (25 - cn_ratio_tmp)/15)); 

      // calculate mineralization rate
      k_base = base_mineralization_rate_k_base /* property_033 */;
      k = k_base * temp_factor * moisture_factor * ph_factor * cn_factor;

      // Step 2: Determine actual mass to mineralize (Robustness check)
      rate = k * time_step; // k is the proportion of stock mineralized

      // consumable organic stocks (current values)
      litter_leaf_stock = leaf_litter /* resource_006 */;
      litter_natural_stock = litter_natural /* resource_007 */;
      litter_cultivated_stock = litter_cultivated /* resource_008 */;
      manure_stock = manure /* resource_031 */;

      // calculate consumed mass for each stock, capped at current stock availability
      consumed_leaf = min(litter_leaf_stock * rate, litter_leaf_stock);
      consumed_natural = min(litter_natural_stock * rate, litter_natural_stock);
      consumed_cultivated = min(litter_cultivated_stock * rate, litter_cultivated_stock);
      consumed_manure = min(manure_stock * rate, manure_stock);

      // Step 3: calculate Mineralized n and c
      n_from_leaf = consumed_leaf * leaf_litter_to_n /* property_046 */;
      n_from_natural = consumed_natural * natural_litter_to_n /* property_002 */;
      n_from_cultivated = consumed_cultivated * cultivated_litter_to_n /* property_083 */;
      n_from_manure = consumed_manure * manure_to_n /* property_085 */;
      n_mineralized = n_from_leaf + n_from_natural + n_from_cultivated + n_from_manure; // Total Mineralized nitrogen

      c_from_leaf = consumed_leaf * leaf_litter_to_c /* property_004 */;
      c_from_natural = consumed_natural * natural_litter_to_c /* property_001 */;
      c_from_cultivated = consumed_cultivated * cultivated_litter_to_c /* property_003 */;
      c_from_manure = consumed_manure * manure_to_c /* property_084 */;
      c_mineralized = c_from_leaf + c_from_natural + c_from_cultivated + c_from_manure; // Total Mineralized carbon 

      // Step 4: Update Resources (Mineral Pools increase, Organic Stocks decrease)
      soil_nitrogen /* resource_001 */ = soil_nitrogen + n_mineralized; 
      soil_carbon /* resource_002 */ = soil_carbon + c_mineralized; 

      leaf_litter /* resource_006 */ = leaf_litter - consumed_leaf; 
      natural_litter /* resource_007 */ = natural_litter - consumed_natural; 
      cultivated_litter /* resource_008 */ = cultivated_litter - consumed_cultivated;
      manure /* resource_031 */ = manure - consumed_manure;" transformationType="AutoTransformation">
          <subjects href="#agent_001" type="straight"/>
          <objects href="#agent_001" type="straight"/>
          <involvedResources href="#resource_006" label="leaf litter" type="straight"/>
          <involvedResources href="#resource_007" label="natural litter" type="straight"/>
          <involvedResources href="#resource_008" label="cultivated litter" type="straight"/>
          <involvedResources href="#resource_031" label="Manure stock" type="straight"/>
          <involvedResources href="#resource_053" label="soil moisture" type="straight"/>
          <involvedResources href="#resource_063" label="soil temperature" type="straight"/>
          <involvedResources href="#resource_052" label="soil pH" type="straight"/>
          <involvedResources href="#resource_005" label="Field capacity" type="straight"/>
          <dependsOnParameters href="#property_033" label="k_base" type="straight"/>
          <dependsOnParameters href="#property_001" label="natural litter to carbon" type="straight"/>
          <dependsOnParameters href="#property_002" label="natural litter to nitrogen" type="straight"/>
          <dependsOnParameters href="#property_003" label="cultivated litter to carbon" type="straight"/>
          <dependsOnParameters href="#property_083" label="cultivated litter to nitrogen" type="straight"/>
          <dependsOnParameters href="#property_046" label="Leaf litter to nitrogen" type="straight"/>
          <dependsOnParameters href="#property_004" label="Leaf litter to carbon" type="straight"/>
          <dependsOnParameters href="#property_085" label="Manure to nitrogen" type="straight"/>
          <dependsOnParameters href="#property_084" label="Manure to carbon" type="straight"/>
          <dependsOnParameters href="#property_032" label="cn Ratio" type="straight"/>
          <affectsResources href="#resource_001" label="nitrogen" type="straight"/>
          <affectsResources href="#resource_002" label="carbon" type="straight"/>
          <affectsResources href="#resource_006" label="Leaf litter" type="straight"/>
          <affectsResources href="#resource_007" label="natural litter" type="straight"/>
          <affectsResources href="#resource_008" label="cultivated litter" type="straight"/>
          <affectsResources href="#resource_031" label="manure stock" type="straight"/>
    </processes>

    <processes xsi:type="ses:TransformationProcess" xmi:id="process_004" id="process_004" name="fertilization" description="Application of synthetic fertilizer to soil, efficiency dependent on soil moisture and pH." comment="Consumes fertilizer stock (resource_015) and adds mineral N to soil (resource_001) based on a dynamic efficiency calculation, with robustness checks for stock availability." pos_x="-1206.61" pos_y="-131.14999999999992" width="120.0" height="60.0" equation="FertApplied = ApplicationRate * Area * Efficiency; Efficiency = BaseEff * f(Moisture) * f(pH)" pseudoCode="
      // Required inputs for logic:
      current_soil_nitrogen = soil_nitrogen /* resource_001 */;
      fertilizer_stock_current = fertilizer_stock /* resource_015 */;
      soil_moisture = soil_moisture /* resource_053 */;
      soil_pH = soil_pH /* resource_052 */;

      // Parameters
      max_nitrogen = max_nitrogen /* property_087 */;
      base_efficiency = base_efficiency /* property_088 */;
      optimal_moisture = optimal_moisture /* property_089 */;
      min_moisture = min_moisture /* property_081 */;
      application_rate = application_rate /* property_066 */;

      // Check conditions for fertilizer application (must have stock and adequate moisture)
      if (soil_moisture &gt; min_moisture and fertilizer_stock_current &gt; 0) {
        // Calculate required N and potential application from stock
        n_needed_by_soil = max(0, max_nitrogen - current_soil_nitrogen);
        potential_application = application_rate; 

        // Determine actual amount of fertilizer consumed (limited by what they want to apply and what they have)
        application_consumed = min(potential_application, fertilizer_stock_current);

        // Calculate efficiency factors
        soil_moisture_factor = min(1, soil_moisture / optimal_moisture);
        
        // Nested condition for pH effect (écrit de manière explicite)
        if (soil_pH &lt; 6) {
          soil_ph_factor = 0.8;
        } else if (soil_pH &gt; 8) {
          soil_ph_factor = 0.7;
        } else {
          soil_ph_factor = 1.0;
        }
        
        // Calculate final efficiency
        efficiency = base_efficiency * soil_moisture_factor * soil_ph_factor;
        
        // Calculate N added to soil 
        n_content_factor = fertilizer_to_n /* property_045 */;
        n_added_to_soil_potential = application_consumed * n_content_factor * efficiency;
        
        // Ensure N_added does not exceed the remaining capacity of the soil
        n_actually_added = min(n_added_to_soil_potential, n_needed_by_soil);
        
        // Update resources (Mass Balance)
        soil_nitrogen = soil_nitrogen + n_actually_added;
        fertilizer_stock = fertilizer_stock - application_consumed;
      } else {
        // Application is zero if moisture is too low or no stock is available
        n_actually_added = 0;
        application_consumed = 0;
      }" transformationType="Modification">
      <subjects href="#agent_005" type="straight"/>
      <objects href="#agent_001" type="straight"/>
      <involvedResources href="#resource_015" label="Fertilizer" type="straight"/>
      <involvedResources href="#resource_048" label="Soil Type" type="straight"/>
      <involvedResources href="#resource_052" label="Soil pH" type="straight"/>
      <involvedResources href="#resource_053" label="Soil Moisture" type="straight"/>
      <involvedResources href="#resource_001" label="Soil Nitrogen" type="straight"/>
      <dependsOnParameters href="#property_066" label="Application Rate" type="straight"/>
      <dependsOnParameters href="#property_087" label="Max Nitrogen" type="straight"/>
      <dependsOnParameters href="#property_088" label="Base Efficiency" type="straight"/>
      <dependsOnParameters href="#property_089" label="Optimal Moisture" type="straight"/>
      <dependsOnParameters href="#property_081" label="Min Moisture" type="straight"/>
      <dependsOnParameters href="#property_045" label="Fertilzer to Nitrogen" type="straight"/>
      <affectsResources href="#resource_015" label="Fertilizer" type="straight"/>
     <affectsResources href="#resource_001" label="Soil Nitrogen" type="straight"/>
    </processes>

    <processes xsi:type="ses:TransformationProcess" xmi:id="process_002" id="process_002" name="Herbaceous_cover_growth" description="Herbaceous cover growth, limited by environment (Rainfall, Soil N) and reduced by grazing pressure." comment="Growth increases Seasonal Fodder (resource_041) and consumes Soil Nitrogen (resource_001) via N_uptake, with added robustness to prevent negative Soil N values." pos_x="230.0" pos_y="-309.0" width="160.0" height="80.0" equation="Growth = r_max * min(1, Rainfall / Rain_opt) * min(1, SoilN / N_opt) * Stress * Quality" pseudoCode="
      // 1. Get Environmental Limiting Factors
      optimal_rainfall = optimal_rainfall /* property_031 */;
      rainfall = rainfall /* resource_010 */;
      rain_factor = min(1, rainfall / optimal_rainfall); 

      soil_nitrogen_current = soil_nitrogen /* resource_001 */;
      n_factor = min(1, soil_nitrogen_current / n_opt);

      // 2. Calculate Grazing Pressure (Stress Factor)
      fodder_consumption_rate = fodder_consumption_rate /* property_060 */;
      total_demand = (young_male_count + young_female_count + 
                      sub_adult_male_count + sub_adult_female_count + 
                      adult_male_count + adult_female_count) * fodder_consumption_rate;

      max_grazing_capacity = max_grazing_capacity /* #property_073 */;
      seasonal_fodder_current = seasonal_fodder /* resource_041 */;

      if (seasonal_fodder_current > 0) {
        // Calculate pressure ratio. Denominator is capped at max(1, ...) to prevent division by zero
        grazing_pressure = min(1.0, total_demand / max(1, seasonal_fodder_current * max_grazing_capacity)); 
      } else {
        // Maximum pressure (1.0) when no fodder is available
        grazing_pressure = 1.0; 
      }

      // Stress is the reduction factor (0-1) where 1 is no stress and 0 is max stress
      stress = max(0, 1 - grazing_pressure);

      // 3. Calculate Final Growth
      r_max = herbaceous_growth_rate /* property_039 */;
      fodder_quality = fodder_quality /* property_053 */;

      growth = r_max * rain_factor * n_factor * stress * fodder_quality; 

      // 4. Update Resources (Mass Balance)
      seasonal_fodder = seasonal_fodder + growth;

      // Nitrogen Uptake (Robustness: Ensure Soil_Nitrogen does not go below zero)
      n_uptake_ratio = herbaceous_n_uptake_ratio /* property_096 */;
      n_consumption_needed = growth * n_uptake_ratio;

      n_deducted = min(n_consumption_needed, soil_nitrogen_current); // Deduct only what's available
      soil_nitrogen = soil_nitrogen - n_deducted;" transformationType="Production">
      <subjects href="#agent_003" type="straight"/>
      <objects href="#agent_003" type="straight"/>
      <involvedResources href="#resource_010" label="Rainfall" type="straight"/>
      <involvedResources href="#resource_001" label="Soil Nitrogen" type="straight"/>
      <involvedResources href="#resource_012" label="Herbaceous Type" type="straight"/>
      <involvedResources href="#resource_004" label="Tree Count" type="straight"/>
      <involvedResources href="#resource_041" label="Seasonal Fodder" type="straight"/>
      <involvedResources href="#resource_019" label="Young Male Count" type="straight"/>
      <involvedResources href="#resource_021" label="Young Female Count" type="straight"/>
      <involvedResources href="#resource_022" label="Sub-Adult Male Count" type="straight"/>
      <involvedResources href="#resource_023" label="Sub-Adult Female Count" type="straight"/>
      <involvedResources href="#resource_024" label="Adult Male Count" type="straight"/>
      <involvedResources href="#resource_025" label="Adult Female Count" type="straight"/>
      <dependsOnParameters href="#property_060" label="Fodder Consumption Rate" type="straight"/>
      <dependsOnParameters href="#property_039" label="Herbaceous Growth Rate (r_max)" type="straight"/>
      <dependsOnParameters href="#property_031" label="Optimal rainfall (used to set Rain_opt)" type="straight"/>
      <dependsOnParameters href="#property_053" label="Fodder Quality" type="straight"/>
      <dependsOnParameters href="#property_073" label="Maximum Grazing Capacity (used to normalise grazing)" type="straight"/>
      <dependsOnParameters href="#property_096" label="herbaceous_n_uptake_ratio" type="straight"/>
      <dependsOnParameters href="#property_097" label="N_opt" type="straight"/>
      <affectsResources href="#resource_041" label="Seasonal Fodder" type="straight"/>
      <affectsResources href="#resource_001" label="Soil Nitrogen" type="straight"/>
    </processes>
    
    <processes xsi:type="ses:TransformationProcess" xmi:id="process_033" id="process_033" name="tree_cover_growth" description="Growth of perennial Tree Biomass, limited by rainfall and soil nitrogen." comment="Increases Tree Biomass (resource_027) and consumes Soil Nitrogen (resource_001) based on a limiting factor model, with robustness checks to prevent negative Soil N." pos_x="100.0" pos_y="-500.0" width="150.0" height="60.0" equation="TreeGrowth = r_max * Biomass * f(Rain) * f(N)" pseudoCode="
      // 1. Get Environmental Limiting Factors
      r_max = tree_growth_rate /* property_124 */;
      current_biomass = biomass /* resource_027 */;

      // Use existing environmental parameters
      rainfall_tmp = rainfall /* resource_010 */;
      optimal_rainfall_tmp = optimal_rainfall /* property_031 */;
      rain_factor = min(1, rainfall_tmp / optimal_rainfall_tmp);

      soil_nitrogen_current = soil_nitrogen /* resource_001 */;
      n_opt_tmp = n_opt /* property_097 */;
      n_factor = min(1, soil_nitrogen_current / n_opt_tmp); 

      // 2. Calculate Potential and Absolute Growth
      growth_rate = r_max * rain_factor * n_factor; 

      tree_growth = current_biomass * growth_rate; 

      // 3. Update Biomass Resource
      biomass /* resource_027 */ = biomass + tree_growth; 

      // 4. Nitrogen Uptake (Mass Balance with Robustness Check)
      n_uptake_ratio = tree_n_uptake_ratio /* property_055 */; 

      // Calculate needed uptake
      n_consumption_needed = tree_growth * n_uptake_ratio;

      // Deduct the minimum of what is needed and what is currently available
      n_deducted = min(n_consumption_needed, soil_nitrogen_current);
      soil_nitrogen /* resource_001 */ = soil_nitrogen - n_deducted;" transformationType="Production">
        <subjects href="#agent_002" label="TreeCover" type="straight"/>
        <objects href="#agent_002" label="TreeCover" type="straight"/>
        <involvedResources href="#resource_027" label="Biomass" type="straight"/>
        <involvedResources href="#resource_010" label="Rainfall" type="straight"/>
        <involvedResources href="#resource_001" label="Soil Nitrogen" type="straight"/>
        <dependsOnParameters href="#property_124" label="Tree Growth Rate (r_max)" type="straight"/>
        <dependsOnParameters href="#property_055" label="Tree N Uptake Ratio" type="straight"/>
        <dependsOnParameters href="#property_031" label="Optimal rainfall" type="straight"/>
        <dependsOnParameters href="#property_097" label="N_opt" type="straight"/>
        <affectsResources href="#resource_027" label="Biomass" type="straight"/>
        <affectsResources href="#resource_001" label="Soil Nitrogen" type="straight"/>
    </processes>

    <processes xsi:type="ses:TransformationProcess" xmi:id="process_022" id="process_022" name="litter_fall" description="Litter fall and drought-induced mortality from perennial Tree Cover biomass to soil organic stocks." comment="Calculates baseline litter fall (Litter Fall Rate) and scales drought-induced mortality (Drought Mortality Rate) based on Soil Moisture stress, with a robustness check to ensure non-negative biomass." pos_x="-1200.0" pos_y="-600.0" width="120.0" height="60.0" equation="LitterFall = (LitterRate + DroughtFactor) * Biomass; DeltaBiomass = -LitterFall" pseudoCode="
      // 1. Get Biomass and Rates
      biomass_stock = Biomass /* resource_027 */;
      base_litter_rate = litter_fall_rate /* property_054 */;
      drought_mortality_rate = drought_mortality_rate /* property_036 */;

      // 2. Get Environmental Condition for Stress Calculation
      soil_moisture = soil_moisture /* resource_053 */; 
      field_capacity = field_capacity /* resource_005 */;

      // Calculate Drought Stress Factor: Scales from 0 (low stress) to 1 (max stress)
      // We use max(0, 1 - ...) to prevent negative stress values if moisture exceeds field capacity
      drought_stress_factor = max(0, 1 - (soil_moisture / field_capacity));

      // Calculate Total Fall Rate: Base rate + stress-induced rate
      total_fall_rate = base_litter_rate + (drought_mortality_rate * drought_stress_factor);

      // 3. Calculate actual litter fall amount (Robustness Check)
      litter_fall_amount_potential = biomass_stock * total_fall_rate;

      // The amount consumed cannot exceed the current stock
      litter_fall_amount = min(litter_fall_amount_potential, biomass_stock);

      // Split litter fall between two natural pools (e.g., 50/50 split)
      litter_to_leaf = litter_fall_amount * 0.5;
      litter_to_natural = litter_fall_amount * 0.5;

      // 4. Update Resources (Mass Balance)
      biomass /* resource_027 */ = biomass - litter_fall_amount; 

      leaf_litter /* resource_006 */ = leaf_litter + litter_to_leaf;
      natural_litter /* resource_007 */ = natural_litter + litter_to_natural;" transformationType="AutoTransformation">
        <subjects href="#agent_002" label="TreeCover" type="straight"/>
        <objects href="#agent_001" label="Soil" type="straight"/>
        <involvedResources href="#resource_027" label="biomass_stock" type="straight"/>
        <involvedResources href="#resource_006" label="Leaf Litter" type="straight"/>
        <involvedResources href="#resource_007" label="Natural Litter" type="straight"/>
        <involvedResources href="#resource_053" label="Soil Moisture" type="straight"/>
        <involvedResources href="#resource_005" label="Field Capacity" type="straight"/>
        <dependsOnParameters href="#property_054" label="Litter Fall Rate" type="straight"/>
        <dependsOnParameters href="#property_036" label="Drought Mortality Rate" type="straight"/> 
        <affectsResources href="#resource_027" label="Biomass" type="straight"/> 
        <affectsResources href="#resource_006" label="Leaf Litter" type="straight"/>
        <affectsResources href="#resource_007" label="Natural Litter" type="straight"/>
    </processes>

    <processes xsi:type="ses:TransformationProcess" xmi:id="process_034" id="process_034" name="crop_production" description="Seasonal production of crop yield and crop residue, limited by environment." comment="Calculates total crop biomass based on Rainfall and Soil Nitrogen, then partitions it into Harvested Yield and Crop Residue (resource_035), with robustness checks for Soil Nitrogen consumption." pos_x="-2023.3280000000003" pos_y="-350.0" width="150.0" height="80.0" equation="TotalBiomass = r_max * Area * f(Rain) * f(N)" pseudoCode="
      // 1. Determine Limiting Factors
      r_max = crop_yield_rate_r_max /* property_120 */;
      total_crop_area = crop_area /* property_065 */;

      // Get current resource values
      rainfall_current = rainfall /* resource_010 */;
      soil_nitrogen_current = soil_nitrogen /* resource_001 */;
      optimal_rainfall = optimal_rainfall /* property_031 */;
      n_opt = n_opt /* property_097 */;

      // Environmental factors
      rain_factor = min(1, rainfall_current / optimal_rainfall);
      n_factor = min(1, soil_nitrogen_current / n_opt); 

      // 2. Calculate Total Biomass Produced
      total_biomass = r_max * total_crop_area * rain_factor * n_factor; 

      // 3. Partition Biomass into Yield and Residue (Harvest Index)
      harvest_index = harvest_index /* property_121 */;

      crop_yield_produced = total_biomass * harvest_index; 
      crop_residue_produced = total_biomass * (1 - harvest_index);

      // 4. Calculate Nitrogen Uptake (Consumption with Robustness Check)
      n_uptake_ratio = crop_n_uptake_ratio /* property_050 */;
      n_consumed_needed = total_biomass * n_uptake_ratio;

      // The amount deducted cannot exceed the current stock
      n_consumed_actual = min(n_consumed_needed, soil_nitrogen_current);

      // 5. Update Resources (Mass Balance)
      // A. Add Residue to the stock (held by Crops Agent)
      crop_residue /* resource_035 */ = crop_residue + crop_residue_produced; 

      // B. Add Yield
      crop_yield /* resource_028 */ = crop_yield + crop_yield_produced; 

      // C. Consume Soil Nitrogen (Mass Balance)
      soil_nitrogen /* resource_001 */ = soil_nitrogen - n_consumed_actual;" transformationType="Production">
         <subjects href="#agent_007" label="Crops" type="straight"/>
         <objects href="#agent_007" label="Crops" type="straight"/>
         <objects href="#agent_005" label="AgroPastoralHouseholds" type="straight"/>
         <involvedResources href="#resource_010" label="Rainfall" type="straight"/>
         <involvedResources href="#resource_001" label="Soil Nitrogen" type="straight"/>
         <involvedResources href="#resource_035" label="Crop Residue" type="straight"/>
         <involvedResources href="#resource_028" label="Crop Yield" type="straight"/>
         <involvedResources href="#resource_056" label="Crop Type" type="straight"/> 
         <involvedResources href="#property_065" label="Crop Area" type="straight"/>    
         <dependsOnParameters href="#property_120" label="Crop Yield Rate (r_max)" type="straight"/>
         <dependsOnParameters href="#property_121" label="Harvest Index" type="straight"/>
         <dependsOnParameters href="#property_031" label="Optimal rainfall" type="straight"/>
         <dependsOnParameters href="#property_097" label="N_opt" type="straight"/>
         <dependsOnParameters href="#property_050" label="crop_n_uptake_ratio" type="straight"/>
         <affectsResources href="#resource_028" label="Crop Yield" type="straight"/>
         <affectsResources href="#resource_035" label="Crop Residue" type="straight"/>
         <affectsResources href="#resource_001" label="Soil Nitrogen" type="straight"/>
    </processes>

    <processes xsi:type="ses:MovementProcess" xmi:id="process_025" id="process_025" name="crop_sale" description="Models the strategic decision of the household to sell a proportion of their crop yield to the market, generating Crop Sale Revenue." comment="An economic transaction converting physical crop stock (resource_028) into revenue (resource_068) based on household strategy and market price, with robustness checks to ensure non-negative stock." pos_x="-1800.0" pos_y="-150.0" width="150.0" height="70.0" equation="\Delta \text{Revenue} = \text{Yield} \times \text{Proportion} \times \text{Price}" pseudoCode="
      // 1. Determine Household Decision and Market Price
      sale_proportion = crop_sale_proportion /* property_130 */; 
      crop_price = crop_market_price /* property_129 */; 
      current_yield_stock = crop_yield /* resource_028 */;

      // Check if there is anything to sell and a decision to sell (proportion > 0)
      if (current_yield_stock > 0 and sale_proportion > 0) {
        // 2. Calculate Transaction Quantities (Robustness Check)
        crop_sold_potential = current_yield_stock * sale_proportion;
        
        // The amount sold cannot exceed the available stock
        crop_sold_actual = min(crop_sold_potential, current_yield_stock);
        
        revenue_generated = crop_sold_actual * crop_price;

        // 3. Update Resources (Mass Balance)
        
        // Increase financial revenue (resource_068)
        crop_sale_revenue /* resource_068 */ = crop_sale_revenue + revenue_generated;
        
        // Consume physical stock (resource_028)
        crop_yield /* resource_028 */ = crop_yield - crop_sold_actual;
      } else {
        crop_sold_actual = 0;
        revenue_generated = 0;
      }" transformationType="MovementProcess">
          <subjects href="#agent_005" label="Agro-Pastoral Households" type="straight"/>
          <objects href="#agent_013" label="Markets" type="straight"/>       
          <objects href="#agent_005" label="Agro-Pastoral Households" type="straight"/>       
          <involvedResources href="#resource_028" label="Crop Yield" type="straight"/>
          <involvedResources href="#resource_068" label="Crop Sale Revenue" type="straight"/> 
          <dependsOnParameters href="#property_130" label="Crop Sale Proportion" type="straight"/>
          <dependsOnParameters href="#property_129" label="Crop Market Price" type="straight"/>
          <affectsResources href="#resource_028" label="Crop Yield" type="straight"/>
          <affectsResources href="#resource_068" label="Crop Sale Revenue" type="straight"/>
          <source href="#agent_005" label="Agro-Pastoral Households" type="straight"/>
          <destination href="#agent_013" label="Markets" type="straight"/>   
    </processes>

    <processes xsi:type="ses:TransformationProcess" xmi:id="process_035" id="process_035" name="crop_residue_partitioning" description="Management of crop residue: partitioning into animal feed and cultivated litter." comment="Consumes Crop Residue stock (resource_035) and allocates it to Seasonal Fodder (resource_033) and Cultivated Litter (resource_008) based on fixed proportions, with checks to handle over-allocation and zero stock." pos_x="-1600.0" pos_y="-350.0" width="150.0" height="80.0" equation="ResidueConsumed = ResidueStock * (GrazingProp + IncorpProp); Feed = Residue * GrazingProp; Litter = Residue * IncorpProp" pseudoCode="
      // Total residue available
      residue_stock = crop_residue /* resource_035 */;

      // Get Proportions
      grazing_prop = residue_grazing_prop /* property_124 */;
      incorporation_prop = residue_incorp_prop /* property_125 */;

      // 1. Conditional Execution and Proportion Scaling (Robustness Check)
      if (residue_stock > 0) {
        // Calculate total requested consumption proportion
        total_management_prop = grazing_prop + incorporation_prop;
        
        if (total_management_prop > 1.0) {
          // Scale proportions down so their sum equals 1.0, consuming all residue
          grazing_prop_actual = grazing_prop / total_management_prop;
          incorporation_prop_actual = incorporation_prop / total_management_prop;
        } else {
          // Use original proportions (leaving unallocated residue in stock)
          grazing_prop_actual = grazing_prop;
          incorporation_prop_actual = incorporation_prop;
        }
        
        // 2. Calculate final allocations
        residue_to_feed = residue_stock * grazing_prop_actual;
        residue_to_litter = residue_stock * incorporation_prop_actual;
        
        // Total mass consumed from stock
        total_residue_consumed = residue_to_feed + residue_to_litter; 
        
        // 3. Update Resources (Mass Balance)
        // Consume the stock (resource_035)
        crop_residue /* resource_035 */ = crop_residue - total_residue_consumed; 
        
        // Increase destination stocks
        crop_residue_to_feed /* resource_033 */ = crop_residue_to_feed + residue_to_feed; 
        cultivated_litter /* resource_008 */ = cultivated_litter + residue_to_litter;
      } else {
        // No action if no residue is available
        residue_to_feed = 0;
        residue_to_litter = 0;
      }" transformationType="Modification">
        <subjects href="#agent_007" label="Crops" type="straight"/>
        <objects href="#agent_001" label="Soil" type="straight"/>
        <objects href="#agent_005" label="AgroPastoralHouseholds" type="straight"/>
        <involvedResources href="#resource_035" label="Crop Residue" type="straight"/>
        <involvedResources href="#resource_033" label="crop_residue_to_feed" type="straight"/>
        <involvedResources href="#resource_008" label="Cultivated Litter" type="straight"/>
        <dependsOnParameters href="#property_124" label="ResidueGrazingProp" type="straight"/>
        <dependsOnParameters href="#property_125" label="ResidueIncorpProp" type="straight"/>
        <affectsResources href="#resource_035" label="Crop Residue" type="straight"/>
        <affectsResources href="#resource_033" label="crop_residue_to_feed" type="straight"/>
        <affectsResources href="#resource_008" label="Cultivated Litter" type="straight"/>
    </processes>

    <processes xsi:type="ses:TransformationProcess" xmi:id="process_036" id="process_036" name="haymaking" description="Conversion of seasonal fodder into storable hay reserves, considering conservation losses and AgroPastoralHouseholds allocation, constrained by labor." comment="Converts Seasonal Fodder (resource_041) into Hay (resource_032) based on a target conservation rate, limited by Available Labor (resource_064) and reduced by Haymaking Efficiency." pos_x="-900.0" pos_y="1300.0" width="150.0" height="60.0" equation="HayProduced = FodderAllocated * LaborFactor * HayEfficiency" pseudoCode="
      // 1. Get available fodder and parameters
      seasonal_fodder_stock = seasonal_fodder /* resource_041 */;
      available_labor_stock = available_labor /* resource_064 */;

      target_conservation_rate = hay_conservation_rate /* property_126 */;
      hay_efficiency = hay_efficiency /* property_127 */;
      labor_needed_rate = haymaking_labor_req_rate /* property_128 */;

      // 2. Conditional Execution (Run only if there is stock and intent to conserve)
      if (seasonal_fodder_stock &gt; 0 and target_conservation_rate &gt; 0) {
        // Amount the household *wants* to allocate for haymaking
        fodder_allocated_potential = seasonal_fodder_stock * target_conservation_rate;
        labor_needed_potential = fodder_allocated_potential * labor_needed_rate;
        
        // Determine the labor constraint factor (1 if enough labor, &lt; 1 if labor limited)
        if (labor_needed_potential &gt; 0) {
          labor_constraint_factor = min(1, available_labor_stock / labor_needed_potential);
        } else {
          labor_constraint_factor = 1;
        }
        
        // Fodder converted is constrained by labor, desire, and stock availability
        fodder_converted_by_labor = fodder_allocated_potential * labor_constraint_factor;
        
        // Final mass consumed from fodder stock (cannot exceed available stock)
        mass_consumed_from_fodder = min(fodder_converted_by_labor, seasonal_fodder_stock);

        // 3. Calculate final Hay Produced and Consumption
        hay_produced = mass_consumed_from_fodder * hay_efficiency;
        
        // Actual labor consumed (based on the amount actually converted)
        labor_consumed = mass_consumed_from_fodder * labor_needed_rate;

        // 4. Update Resources (Mass Balance)
        
        // Consume source (Seasonal Fodder resource_041)
        seasonal_fodder /* resource_041 */ = seasonal_fodder - mass_consumed_from_fodder; 
        
        // Increase destination (Hay resource_032)
        hay /* resource_032 */ = hay + hay_produced;
        
        // Consume Labor (resource_064)
        available_labor /* resource_064 */ = available_labor - labor_consumed;
      } else {
        // Zero out if conditions are not met
        hay_produced = 0;
        mass_consumed_from_fodder = 0;
        labor_consumed = 0;
      }" transformationType="Production">
          <subjects href="#agent_005" label="AgroPastoralHouseholds" type="straight"/>
          <objects href="#agent_005" label="AgroPastoralHouseholds" type="straight"/>
          <involvedResources href="#resource_041" label="Seasonal Fodder" type="straight"/>
          <involvedResources href="#resource_032" label="Hay" type="straight"/>
          <involvedResources href="#resource_064" label="Available labor" type="straight"/>
          <dependsOnParameters href="#property_126" label="Hay Conservation Rate" type="straight"/>
          <dependsOnParameters href="#property_127" label="Hay efficiency" type="straight"/>
          <dependsOnParameters href="#property_128" label="haymaking_labor_req_rate" type="straight"/>
          <affectsResources href="#resource_041" label="Seasonal Fodder" type="straight"/>
          <affectsResources href="#resource_032" label="Hay" type="straight"/>
          <affectsResources href="#resource_064" label="Available labor" type="straight"/>
    </processes>

    <processes xsi:type="ses:TransformationProcess" xmi:id="process_075" id="process_075" name="cultivated_forage_production" description="Models the deliberate cultivation and harvest of a specific forage crop by the household, consuming labor and inputs to produce a dedicated feed stock." comment="Household-driven production, consuming labor and technical inputs (fertilizer) to generate a private stock (resource_072). Includes robustness checks for input availability and harvest efficiency." pos_x="-800.0" pos_y="-200.0" width="170.0" height="70.0" equation="Delta_Stock = Area * Yield_Base * Product_Factors * Harvest_Eff" pseudoCode="
      // 1. Strategic Decision and Preliminary Calculations
      forage_crop_area_proportion = forage_crop_area_prop /* property_148 */;
      cropped_area_tmp = crop_Area /* resource_038 */;
      area_forage = cropped_area_tmp * forage_crop_area_proportion; 

      labor_rate = labor_rate_forage /* property_149 */; 
      fertilization_rate_tmp = fertilization_rate /* property_151 */;

      // Ensure the process only runs if area is allocated
      if (area_forage > 0) {
        // 2. Input Consumption and Factor Calculation (Robustness Check)
        // Calculate theoretical fertilizer need
        fertilization_cost_needed = fertilization_rate_tmp * area_forage;
        fertilizer_available = Fertilizer /* resource_015 */;
        
        // Actual consumption is the minimum of what is needed and what is available
        actual_fertilizer_applied = min(fertilization_cost_needed, fertilizer_available);
        fertilization_cost = actual_fertilizer_applied;

        // Determine fertilization factor based on actual application
        if (actual_fertilizer_applied > 0) {
          fertilization_factor_used = fertilization_eff_factor /* property_150 */;
        } else {
          fertilization_factor_used = 1.0; // No fertilizer applied, no yield boost
        }
        
        // 3. Environmental Constraints (Limit the Yield)
        rainfall_input = Rainfall /* resource_010 */;
        
        base_yield = base_forage_yield /* property_147 */; // Max potential crop yield
        rain_factor = rainfall_efficiency_factor /* property_153 */;
        soil_nitrogen_tmp = Soil_Nirogen /* resource_001 */;
        soil_quality_influence_factor = soil_quality_influence_factor /* property_152 */;
        soil_factor = soil_nitrogen_tmp * soil_quality_influence_factor;
        
        // 4. Calculate Production and Harvest
        yield_modifier = rain_factor * soil_factor * fertilization_factor_used;
        fodder_produced = area_forage * base_yield * yield_modifier;
        
        // Apply realism: Account for harvest losses
        harvest_efficiency = Harvest_Efficiency_Factor /* property_154 */;
        final_stock_added = fodder_produced * harvest_efficiency;
        
        labor_consumed = area_forage * labor_rate;
        
        // 5. Update Resources (Mass Balance)
        forage_crop_production /* resource_072 */ = forage_crop_production + final_stock_added; 
        available_labor /* resource_064 */ = available_labor - labor_consumed; 
        fertilizer /* resource_015 */ = fertilizer - fertilization_cost;
      } else {
        // area_forage is 0, so nothing is produced or consumed
        final_stock_added = 0;
        labor_consumed = 0;
        fertilization_cost = 0; 
      }" transformationType="Production">
         <subjects href="#agent_005" label="Agro-Pastoral Households" type="straight"/> 
         <objects href="#agent_001" label="Soil" type="straight"/>
         <involvedResources href="#resource_072" label="Forage Crop Stock" type="straight"/>
         <involvedResources href="#resource_064" label="Available Labor" type="straight"/>
         <involvedResources href="#resource_038" label="Cropped Area" type="straight"/>
         <involvedResources href="#resource_010" label="Rainfall" type="straight"/>
         <involvedResources href="#resource_001" label="Soil Nitrogen" type="straight"/>
         <involvedResources href="#resource_015" label="Fertilizer" type="straight"/> 
         <affectsResources href="#resource_072" label="Forage Crop Stock" type="straight"/>
         <affectsResources href="#resource_064" label="Available Labor" type="straight"/>
         <affectsResources href="#resource_015" label="Fertilizer" type="straight"/>
         <dependsOnParameters href="#property_147" label="Base Forage Yield" type="straight"/>
         <dependsOnParameters href="#property_153" label="Rainfall Efficiency Factor" type="straight"/>
         <dependsOnParameters href="#property_152" label="Soil Quality Influence Factor" type="straight"/>
         <dependsOnParameters href="#property_148" label="Forage Crop Area Proportion" type="straight"/>
         <dependsOnParameters href="#property_149" label="Labor Rate Forage" type="straight"/>
         <dependsOnParameters href="#property_150" label="Fertilization Efficiency Factor" type="straight"/>
         <dependsOnParameters href="#property_151" label="Fertilization Rate" type="straight"/>
         <dependsOnParameters href="#property_154" label="Harvest Efficiency Factor" type="straight"/>
    </processes>

    <processes xsi:type="ses:TransformationProcess" xmi:id="process_037" id="process_037" name="cultivated_forage_harvest" description="Harvest and partitioning of dedicated forage crop biomass into hay reserves and cultivated litter/bedding." comment="Converts the raw forage crop stock (resource_070) into Hay (resource_032) and Cultivated Litter (resource_008), with a loss factor for hay production. Strictly a production process, with no consumption of the final product." pos_x="-900.0" pos_y="1300.0" width="150.0" height="70.0" equation="Hay = Stock * (1 - LitterProp) * Efficiency; Litter = Stock * LitterProp" pseudoCode="
      // 1. Get available raw stock and parameters
      raw_forage_stock = forage_crop_production /* resource_072 */;
      litter_proportion = litter_proportion /* property_155 */;
      hay_harvest_efficiency = hay_harvest_efficiency /* property_156 */;

      // 2. Conditional Execution (Check if there is stock to harvest)
      if (raw_forage_stock > 0) {
        // 3. Partition the harvest
        
        // Mass that remains as litter/bedding (resource_008)
        litter_to_bedding = raw_forage_stock * litter_proportion;
        
        // Potential hay mass (raw stock minus litter proportion)
        potential_hay_mass = raw_forage_stock * (1 - litter_proportion);
        
        // Final hay mass after drying/harvest losses (resource_032)
        hay_produced = potential_hay_mass * hay_harvest_efficiency;
        
        // Total mass consumed from the raw stock (mass balance)
        total_mass_consumed = raw_forage_stock; 

        // 4. Update Resources (Mass Balance)
        
        // Consume source (forage_crop_production resource_072)
        forage_crop_production /* resource_072 */ = forage_crop_production - total_mass_consumed; 
        
        // Increase destination 1: Hay (resource_032)
        hay /* resource_032 */ = hay + hay_produced;
        
        // Increase destination 2: Cultivated Litter (resource_008)
        cultivated_litter /* resource_008 */ = cultivated_litter + litter_to_bedding;
      } else {
        hay_produced = 0;
        litter_to_bedding = 0; 
      }" transformationType="Production">
          <subjects href="#agent_007" label="Crops" type="straight"/>
          <objects href="#agent_005" label="AgroPastoralHouseholds" type="straight"/>
          <objects href="#agent_001" label="Soil" type="straight"/>
