    <processes xsi:type="ses:TransformationProcess" xmi:id="process_007" id="process_007" name="watering" description="Water intake by livestock (demand-driven, limited by availability)" comment="Compute herd water demand from body weight, temperature and physiological state; supply limited by water stock; shortages affect hydration and health" pos_x="-564.0" pos_y="1624.0" width="200.0" height="90.0"  equation="WaterDemand = Σ(BodyWeight_i * BaseRate * TempFactor * PhysiologicalFactor); WaterSupplied = min(WaterDemand, WaterAvailable); WaterAvailable = WaterAvailable - WaterSupplied; hydration_stress_factor = f(WaterDemand, WaterSupplied)" pseudoCode="
      // 1. Initialize Demand and Factors
      base_rate = water_consumption_rate;         // L/kg/day /* property_061 */
      temp_factor = 1 + max(0, (temperature - 25) * 0.02);   // increase need with temp /* resource_013 */
      physio_factor = 1 + lactation_need * 0.5;              // lactating animals need more /* property_063 */

      // 2. Calculate Total Water Demand based on animal counts and class weights
      // NOTE: Class weights (body_weight_i) are retrieved from property_052/body_weight parameter's internal structure

      // Sum demand across all classes (simplified aggregate)
      total_animals = young_male_count 
                    + young_female_count 
                    + sub_adult_male_count 
                    + sub_adult_female_count 
                    + adult_male_count 
                    + adult_female_count;

      if (total_animals > 0) {
        herd_biomass = total_animals * body_weight_default /* property_052 */;
      } else {
        herd_biomass = 0;
      }

      water_demand = herd_biomass * base_rate * temp_factor * physio_factor;

      // 3. Determine Water Supplied and Resource Update
      water_stock_available = water /* resource_042 */;
      water_supplied = min(water_demand, water_stock_available);
      water /* resource_042 */ = water - water_supplied; // Affects Water resource

      // 4. Calculate Hydration Stress Output (for process_008)
      hydration_ratio = water_supplied / max(water_demand, 1e-6);

      if (hydration_ratio &lt; 1.0) {
        // Stress is proportional to the deficit (1 - ratio)
        hydration_stress_factor = (1.0 - hydration_ratio) * 1.0; 
      } else {
        // Zero stress if demand is met
        hydration_stress_factor = 0.0;
      }

      // Output stress to new resource for use in process_008
      hydration_stress_factor /* resource_076 */ = hydration_stress_factor;" transformationType="Consumption">
      <subjects href="#agent_005" label="agro_pastoral_households" type="straight"/>
      <objects href="#agent_006" label="livestock" type="straight"/>
      <objects href="#agent_012" label="water_sources" type="straight"/>
      <involvedResources href="#resource_042" label="water" type="straight"/>
      <involvedResources href="#resource_013" label="temperature" type="straight"/>
      <involvedResources href="#resource_047" label="body_weight" type="straight"/>
      <involvedResources href="#resource_025" label="adult_female_count" type="straight"/>
      <involvedResources href="#resource_024" label="adult_male_count" type="straight"/>
      <involvedResources href="#resource_019" label="young_male_count" type="straight"/>
      <involvedResources href="#resource_021" label="young_female_count" type="straight"/>
      <involvedResources href="#resource_022" label="sub_adult_male_count" type="straight"/>
      <involvedResources href="#resource_023" label="sub_adult_female_count" type="straight"/>
      <dependsOnParameters href="#property_061" label="water_consumption_rate" type="straight"/>
      <dependsOnParameters href="#property_059" label="water_need" type="straight"/>
      <dependsOnParameters href="#property_063" label="lactation_need" type="straight"/>
      <dependsOnParameters href="#property_052" label="body_weight_default" type="straight"/>
      <dependsOnParameters href="#property_036" label="drought_mortality_rate" type="straight"/>
      <dependsOnParameters href="#property_048" label="water_availability" type="straight"/>
      <affectsResources href="#resource_042" label="water" type="straight"/>
