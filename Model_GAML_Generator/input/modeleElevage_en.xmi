      <affectsResources href="#resource_031" label="Manure" type="straight"/>
      <affectsResources href="#resource_049" label="faeces" type="straight"/>
      <affectsResources href="#resource_050" label="Urine" type="straight"/>
      <source href="#agent_006" label="Herd" type="straight"/>
      <destination href="#agent_001" label="Soil" type="straight"/>
    </processes>

    <processes xsi:type="ses:MovementProcess" xmi:id="process_013" id="process_013" name="fertilizer_purchase" description="Purchase of fertilizer by the household, transferring cash to stock." comment="Household chooses quantity (Qty) and pays Fertilizer Price, increasing the Available Fertilizer Stock." pos_x="-1600.042" pos_y="196.53" width="118.0" height="44.0" equation="Cost = Qty * PriceFert; ΔStock = Qty; ΔCash = -Cost" pseudoCode="
      // Calculate Cost (from parameters)
      cost = quantity * fertilizer_price /* property_023 */;
      purchased_qty = quantity /* property_024 */;

      // Decision: Check affordability
      if (cash >= cost and available_fertilizer_stock >= purchased_qty) {
        // Execute Purchase
        
        // 1. Decrease AgroPastoralHouseholds Cash
        cash /* resource_014 */ = cash - cost;

        // 2. Decrease Market Stock
        available_fertilizer_stock /* resource_037 */ = available_fertilizer_stock - purchased_qty;

        // 3. Increase AgroPastoralHouseholds Stock
        Fertilizer_Stock /* resource_015 */ = Fertilizer_Stock + purchased_qty;
      } else {
        // Purchase failed (not enough cash or market stock)
        purchased_qty = 0;
      }">
      <subjects href="#agent_005" type="straight"/>
      <objects href="#agent_013" type="straight"/>
      <involvedResources href="#resource_014" label="Cash" type="straight"/>
      <involvedResources href="#resource_037" label="Available Fertilizer Stock (Market)" type="straight"/> 
      <affectsResources href="#resource_015" label="Fertilizer (Household)" type="straight"/>
      <dependsOnParameters href="#property_023" label="Fertilizer Price" type="straight"/>
      <dependsOnParameters href="#property_024" label="quantity" type="straight"/>
      <affectsResources href="#resource_014" label="Cash" type="straight"/>
      <affectsResources href="#resource_037" label="Available Fertilizer Stock (Market)" type="straight"/>
      <affectsResources href="#resource_015" label="Fertilizer (Household)" type="straight"/>
      <source href="#agent_013" label="Market" type="straight"/>
      <destination href="#agent_005" label="Household" type="straight"/>
    </processes>

    <processes xsi:type="ses:MovementProcess" xmi:id="process_014" id="process_014" name="concentrate_purchase" description="Purchase of concentrate by AgroPastoralHouseholds from Markets." comment="Transfers quantity from Market Stock (resource_038) to AgroPastoralHouseholds Stock (resource_034) in exchange for Cash (resource_014)." pos_x="-1890.444" pos_y="737.9020000000002" width="167.84000000000015" height="90.0" equation="Cost = Qty * PriceConc; ΔConcentrate = +Qty; ΔAvailableStock = -Qty; ΔCash = -Cost" pseudoCode="
      // Calculate Cost and quantity
      purchased_qty = quantity /* property_025 */;
      cost = purchased_qty * concentrate_price /* property_022 */;

      // Decision: Check affordability and market stock availability
      if (cash >= cost and available_concentrate_stock >= purchased_qty) {
        // Execute Purchase and Transfer
        
        // 1. Decrease AgroPastoralHouseholds Cash
        cash /* resource_014 */ = cash - cost; 
        
        // 2. Decrease Market Stock
        available_concentrate_stock /* resource_038 */ = available_concentrate_stock + purchased_qty;
        
        // 3. Increase AgroPastoralHouseholds Stock
        concentrate /* resource_034 */ =  concentrate + purchased_qty;
      } else {
        // Purchase failed (not enough cash or market stock)
        purchased_qty = 0;
      }">
      <subjects href="#agent_005" type="straight"/>
      <objects href="#agent_013" type="straight"/>
      <involvedResources href="#resource_014" label="Cash" type="straight"/>
      <involvedResources href="#resource_034" label="Concentrate (Household Stock)" type="straight"/>
