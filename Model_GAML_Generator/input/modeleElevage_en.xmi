    <processes xsi:type="ses:TransformationProcess" xmi:id="process_008" id="process_008" name="animal_health_status" description="Updates animal health and body condition based on nutrition, climate stress, and veterinary interventions (PRAPS model)." comment="Links feed intake and climate stress to dynamic health status, which in turn influences demography (process_010)." pos_x="10.0" pos_y="1600.0" width="130.0" height="70.0" equation="ΔHealth = f(Nutrition, Disease, Intervention, Water); ΔCondition = f(Intake Ratio)" pseudoCode="
      // 0. Retrieve Inputs
      // Status Metrics
      current_body_condition = body_condition /* resource_046 */; 
      current_livestock_health = livestock_health /* resource_040 */;

      // Drivers (From other processes/parameters)
      intake_ratio = daily_intake_ratio /* resource_075 */; // Output of process_003
      disease_prevalence = disease_prevalence_index /* resource_074 */;
      climate_stress_factor = drought_mortality_rate /* property_036 */; // Re-use drought stress as a health stressor
      hydration_stress = hydration_stress_factor /* resource_076 */; // Output of process_007

      // Intervention Parameters
      vet_access_score = vet_service_access /* property_161 */;
      vaccination_rate = herd_vaccination_rate /* property_162 */;
      intervention_efficacy = treatment_efficacy /* property_163 */;

      // Define constants for rate of change (delta per time step)
      health_recovery_rate = health_recovery_rate /* property_157 */; 
      health_decline_rate = health_decline_rate /* property_158 */; 
      condition_recovery_rate = condition_recovery_rate /* property_159 */; 
      condition_decline_rate = condition_decline_rate /* property_160 */;

      // 1. Update Body Condition (Metabolic Link)
      // Body condition is primarily driven by the ratio of intake to requirement (intake_ratio)

      // Condition Change is proportional to intake deficit or surplus
      condition_change = intake_ratio - 1.0; 

      if (condition_change &gt; 0) {
        // Surplus: Condition improves
        delta_condition = condition_change * condition_recovery_rate;
      } else {
        // Deficit: Condition declines (decline rate is often higher than recovery rate)
        delta_condition = condition_change * condition_decline_rate;
      }

      // NOTE: Water stress also reduces body condition, scaled by decline rate
      delta_condition = delta_condition - hydration_stress * condition_decline_rate * 0.5; // Moderate impact

      new_body_condition = current_body_condition + delta_condition;

      // Constrain Body Condition to [0, 1]
      body_condition /* resource_046 */ = max(0.0, min(1.0, new_body_condition));

      // 2. Update Livestock Health (Disease and Intervention Link)

      // A. Baseline Decline (Stressors)
      // Health declines due to climate stress, water stress, and prolonged poor body condition
      climate_decline = climate_stress_factor * health_decline_rate;
      hydration_decline = hydration_stress * health_decline_rate * 3.0; // High impact of water stress on health
      condition_penalty = (1.0 - current_body_condition) * health_decline_rate; // Poor condition penalizes health

      // B. Disease Impact
      disease_impact = disease_prevalence * health_decline_rate * 2.0; // Disease has a strong negative impact

      // C. Intervention Impact 
      // Intervention benefit is high if access is good, vaccination is high, and efficacy is high.
      intervention_benefit = vet_access_score * vaccination_rate * intervention_efficacy * health_recovery_rate;

      // D. Net Health Change
      total_health_decline = climate_decline + hydration_decline + condition_penalty + disease_impact;

      delta_health = intervention_benefit - total_health_decline;

      new_livestock_health = current_livestock_health + delta_health;

      // Constrain Livestock Health to [0, 1]
      livestock_health /* resource_040 */ = max(0.0, min(1.0, new_livestock_health));" transformationType="Modification">
      <subjects href="#agent_006" label="livestock" type="straight"/>
      <objects href="#agent_006" label="livestock" type="straight"/>
      <involvedResources href="#resource_040" label="livestock_health" type="straight"/>
      <involvedResources href="#resource_046" label="body_condition" type="straight"/>
      <involvedResources href="#resource_075" label="daily_intake_ratio" type="straight"/>
      <involvedResources href="#resource_074" label="disease_prevalence_index" type="straight"/>
      <involvedResources href="#resource_076" label="hydration_stress_factor" type="straight"/>       
      <dependsOnParameters href="#property_036" label="drought_mortality_rate" type="straight"/>
      <dependsOnParameters href="#property_161" label="vet_service_access" type="straight"/>
      <dependsOnParameters href="#property_162" label="herd_vaccination_rate" type="straight"/>
      <dependsOnParameters href="#property_163" label="intervention_efficacy" type="straight"/>
      <dependsOnParameters href="#property_157" label="health_recovery_rate" type="straight"/>
      <dependsOnParameters href="#property_158" label="health_decline_rate" type="straight"/>
      <dependsOnParameters href="#property_159" label="condition_recovery_rate" type="straight"/>
      <dependsOnParameters href="#property_160" label="condition_decline_rate" type="straight"/>
      <affectsResources href="#resource_040" label="livestock_health" type="straight"/>
      <affectsResources href="#resource_046" label="body_condition" type="straight"/>
    </processes>
    
    <processes xsi:type="ses:TransformationProcess" xmi:id="process_010" id="process_010" name="herd_demography" description="Herd demographic dynamics: Births, aging, and mortality driven by environmental stress and animal health." comment="DynMod model for population change. Mortality is influenced by drought (property_036) and animal status (resources 040, 046)." pos_x="601.6999999999999" pos_y="1641.4899999999998" width="118.0" height="46.0" equation="ΔN(class) = Births(class) - Mortality(class) + Inflow(class) - Outflow(class)" pseudoCode="
      // 0. Retrieve Parameters and Status
      // Reproduction Parameters
      adult_female_reprod_rate = adult_female_reprod_rate /* property_016 */;
      sub_adult_female_reprod_rate = sub_adult_female_reprod_rate /* property_017 */;
      sex_ratio_male = sex_ratio /* property_101 */;

      // Mortality and Status
      drought_mortality_rate = drought_mortality_rate /* property_036 */;
      livestock_health = livestock_health /* resource_040 */; // Scale 0 (worst) to 1 (best)
      body_condition = body_condition /* resource_046 */; // Scale 0 (worst) to 1 (best)

      // Aging Durations
      young_male_duration = young_male_max_age - young_male_min_age /* property_014 */;
      young_female_duration = young_female_max_age - young_female_min_age /* property_102 */;
      sub_adult_duration = sub_adult_age_duration /* property_104 */;

      // 1. Calculate Overall Mortality Multiplier (Health and Stress Link)
      // Health Deficit (1.0 = perfect health, 0.0 = average health/condition is 0)
      health_status_score = (livestock_health + body_condition) / 2.0; 
      health_deficit_factor = max(0.0, 1.0 - health_status_score);

      // Use a sensitivity factor (Placeholder for future property, e.g., 0.5)
      health_impact_sensitivity = 0.5; 

      // Overall Multiplier (Base 1.0 + Drought Shock + Health/Condition Penalty)
      overall_mortality_multiplier = 1.0 + drought_mortality_rate + (health_deficit_factor * health_impact_sensitivity);
      overall_mortality_multiplier = max(1.0, overall_mortality_multiplier);

      // 2. Calculate Births (Applies to Young classes)
      total_births = (adult_female_count * adult_female_reprod_rate) 
                  + (sub_adult_female_count * sub_adult_female_reprod_rate);

      young_male_count_inflow = total_births * sex_ratio_male;
      young_female_count_inflow = total_births * (1.0 - sex_ratio_male);

      // 3. Calculate Mortality and Aging Transitions (Temporal Update)

      // A. Young Male Class Transition (YM -> SAM)
      aging_out_YM = young_male_count * (1.0 / max(1.0, young_male_duration)); 
      deaths_YM = young_male_count * young_male_mortality_rate * overall_mortality_multiplier; 

      sub_adult_male_count /* resource_022 */ = sub_adult_male_count + aging_out_YM; 
      young_male_count /* resource_019 */ = max(0.0, young_male_count + young_male_count_inflow - deaths_YM - aging_out_YM);

      // B. Young Female Class Transition (YF -> SAF)
      aging_out_YF = young_female_count * (1.0 / max(1.0, young_female_duration));
      deaths_YF = young_female_count * young_female_mortality_rate * overall_mortality_multiplier;

      sub_adult_female_count /* resource_023 */ = sub_adult_female_count + aging_out_YF; 
      young_female_count /* resource_021 */ = max(0.0, young_female_count + young_female_count_inflow - deaths_YF - aging_out_YF);

      // C. Sub-Adult Male Class Transition (SAM -> AM)
      aging_out_SAM = sub_adult_male_count * (1.0 / max(1.0, sub_adult_duration)); 
      deaths_SAM = sub_adult_male_count * sub_adult_male_mortality_rate * overall_mortality_multiplier; 

      adult_male_count /* resource_024 */ = adult_male_count + aging_out_SAM;
      sub_adult_male_count /* resource_022 */ = max(0.0, sub_adult_male_count - deaths_SAM - aging_out_SAM); 

      // D. Sub-Adult Female Class Transition (SAF -> AF)
      aging_out_SAF = sub_adult_female_count * (1.0 / max(1.0, sub_adult_duration));
      deaths_SAF = sub_adult_female_count * sub_adult_female_mortality_rate * overall_mortality_multiplier;

      adult_female_count /* resource_025 */ = adult_female_count + aging_out_SAF;
      sub_adult_female_count /* resource_023 */ = max(0.0, sub_adult_female_count - deaths_SAF - aging_out_SAF);

      // E. Adult Classes (Only Mortality)
      deaths_AM = adult_male_count * adult_male_mortality_rate * overall_mortality_multiplier; 
      adult_male_count /* resource_024 */ = max(0.0, adult_male_count - deaths_AM);

      deaths_AF = adult_female_count * adult_female_mortality_rate * overall_mortality_multiplier; 
      adult_female_count /* resource_025 */ = max(0.0, adult_female_count - deaths_AF);

      // 4. Track Total Mortality (for output/metrics)
      total_mortality = deaths_YM + deaths_YF + deaths_SAM + deaths_SAF + deaths_AM + deaths_AF;
      // Suggestion: assigner total_mortality à une ressource dédiée pour suivi, ex. :
      // total_mortality_resource /* resource_XXX */ = total_mortality;" transformationType="Modification">
      <subjects href="#agent_006" type="straight"/>
      <objects href="#agent_006" type="straight"/>
      <involvedResources href="#resource_019" label="Young Male Count" type="straight"/>
      <involvedResources href="#resource_021" label="Young Female Count" type="straight"/>
      <involvedResources href="#resource_022" label="Sub-Adult Male Count" type="straight"/>
      <involvedResources href="#resource_023" label="Sub-Adult Female Count" type="straight"/>
      <involvedResources href="#resource_024" label="Adult Male Count" type="straight"/>
      <involvedResources href="#resource_025" label="Adult Female Count" type="straight"/>
      <involvedResources href="#resource_040" label="Livestock Health" type="straight"/>
      <involvedResources href="#resource_046" label="Body Condition" type="straight"/>
      <dependsOnParameters href="#property_013" label="Young Male Mortality Rate" type="straight"/>
      <dependsOnParameters href="#property_075" label="Young Female Mortality Rate" type="straight"/>
      <dependsOnParameters href="#property_076" label="Sub-Adult Male Mortality Rate" type="straight"/>
      <dependsOnParameters href="#property_077" label="Sub-Adult Female Mortality Rate" type="straight"/>
      <dependsOnParameters href="#property_078" label="Adult Male Mortality Rate" type="straight"/>
      <dependsOnParameters href="#property_079" label="Adult Female Mortality Rate" type="straight"/>
      <dependsOnParameters href="#property_104" label="Sub Adult Age Duration" type="straight"/>
      <dependsOnParameters href="#property_014" label="Young Male Min Age" type="straight"/>
      <dependsOnParameters href="#property_015" label="Young Male Max Age" type="straight"/>
      <dependsOnParameters href="#property_102" label="Young Female Min Age" type="straight"/>
      <dependsOnParameters href="#property_103" label="Young Female Max Age" type="straight"/>
      <dependsOnParameters href="#property_016" label="Adult Female Reproduction Rate" type="straight"/>
      <dependsOnParameters href="#property_017" label="Sub-Adult Female Reproduction Rate" type="straight"/>
      <dependsOnParameters href="#property_101" label="Sex Ratio (Male:Female)" type="straight"/>
      <dependsOnParameters href="#property_036" label="Drought Mortality Rate" type="straight"/>
      <affectsResources href="#resource_019" label="Young Male Count" type="straight"/>
      <affectsResources href="#resource_021" label="Young Female Count" type="straight"/>
      <affectsResources href="#resource_022" label="Sub-Adult Male Count" type="straight"/>
      <affectsResources href="#resource_023" label="Sub-Adult Female Count" type="straight"/>
      <affectsResources href="#resource_024" label="Adult Male Count" type="straight"/>
      <affectsResources href="#resource_025" label="Adult Female Count" type="straight"/> 
    </processes>

    <processes xsi:type="ses:TransformationProcess" xmi:id="process_072" id="process_072" name="tlu_calculation" description="Aggregates the counts of all six livestock classes into a single Tropical Livestock Unit (TLU) metric." comment="This calculation provides the Herd TLU (resource_040), which is used to determine grazing pressure (process_020) and overall herd value." pos_x="-1700.0" pos_y="750.0" width="180.0" height="70.0" equation="\text{Herd TLU} = \sum_{i=1}^{6} (\text{Class}_{i} \times \text{Rate}_{i})" pseudoCode="
      // Calculate TLU for each class (Tropical Livestock Unit equivalent)
      TLU_young_male = young_male_count * tlu_rate_young_male /* property_138 */;
      TLU_young_female = young_female_count * tlu_rate_young_female /* property_139 */;
      TLU_sub_adult_male = sub_adult_male_count * tlu_rate_sub_adult_male /* property_140 */;
      TLU_sub_adult_female = sub_adult_female_count * tlu_rate_sub_adult_female /* property_141 */;
      TLU_adult_male = adult_male_count * tlu_rate_adult_male /* property_142 */;
      TLU_adult_female = adult_female_count * tlu_rate_adult_female /* property_143 */;

      // Calculate Total Herd TLU
      New_Herd_TLU = TLU_young_male 
                  + TLU_young_female 
                  + TLU_sub_adult_male 
                  + TLU_sub_adult_female 
                  + TLU_adult_male 
                  + TLU_adult_female;

      // Update Resource (Herd TLU resource_069)
      herd_tlu /* resource_069 */ = New_Herd_TLU; // Overwrite previous value" transformationType="Modification">
          <subjects href="#agent_005" label="Agro-Pastoral Households" type="straight"/>
          <objects href="#agent_006" label="Herd" type="straight"/>
          <involvedResources href="#resource_019" label="Young Male Count" type="straight"/>
          <involvedResources href="#resource_021" label="Young Female Count" type="straight"/>
          <involvedResources href="#resource_022" label="Sub-Adult Male Count" type="straight"/>
          <involvedResources href="#resource_023" label="Sub-Adult Female Count" type="straight"/>
          <involvedResources href="#resource_024" label="Adult Male Count" type="straight"/>
          <involvedResources href="#resource_025" label="Adult Female Count" type="straight"/>
          <involvedResources href="#resource_040" label="Herd TLU" type="straight"/>
          <dependsOnParameters href="#property_138" label="TLU Rate young male" type="straight"/>
          <dependsOnParameters href="#property_139" label="TLU Rate young female" type="straight"/>
          <dependsOnParameters href="#property_140" label="TLU Rate sub-adult male" type="straight"/>
          <dependsOnParameters href="#property_141" label="TLU Rate sub-adult female" type="straight"/>
          <dependsOnParameters href="#property_142" label="TLU Rate adult male" type="straight"/>
          <dependsOnParameters href="#property_143" label="TLU Rate adult female" type="straight"/>
          <affectsResources href="#resource_040" label="Herd TLU" type="straight"/>
    </processes>
    
    <processes xsi:type="ses:MovementProcess" xmi:id="process_011" id="process_011" name="manure_production" description="Manure production by livestock" comment="Based on nutrient excretion rates" pos_x="-246.0" pos_y="1350.0" width="150.0" height="60.0" equation="ΔManure=(Feces + Urine) * Deposition_Rate" pseudoCode="
        // 1. Get raw waste production from the previous time step (outputs of process_023)
        total_waste_mass = faeces + urine /* resource_050 */;

        // 2. Apply deposition/loss rate
        deposition_factor = manure_deposition_rate /* property_105 */;
        final_manure_addition = total_waste_mass * deposition_factor;

        // 3. Update the Manure Resource
        manure /* resource_031 */ = manure + final_manure_addition;

        // 4. Clear/Reset the intermediate waste resources
        faeces /* resource_049 */ = 0;
        urine /* resource_050 */ = 0;">
      <subjects href="#agent_006" label="Herd" type="straight"/>
      <objects href="#agent_001" label="Soil" type="straight"/>
