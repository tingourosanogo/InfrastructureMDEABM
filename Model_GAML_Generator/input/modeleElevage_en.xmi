    </processes>

    <processes xsi:type="ses:TransformationProcess" xmi:id="process_023" id="process_023" name="nutrient_absorption" description="Nutrient absorption, metabolism, and excretion by livestock" comment="Calculates nutrient mass absorbed based on animal health/condition and determines the residual mass to be excreted as feces and urine." pos_x="-246.0" pos_y="1500.0" width="180.0" height="80.0" equation="NutrientAbsorbed = IntakeN * AbsorptionCapacity; ExcretedN = IntakeN - NutrientAbsorbed; WasteOutput = ExcretedN * WasteProportion" pseudoCode="
      // Input: Total mass of nutrients consumed in this step (from resource_051, set by process_003)
      nutrients_consumed = nutrients_consumed /* resource_051 */;

      // 1. Calculate Absorption
      // Calculate absorption capacity based on animal factors
      absorption_capacity = base_absorption_rate * body_condition * livestock_health /* property_086 resource_046 resource_040 */;
      absorption_rate = min(1.0, absorption_capacity); // Cap absorption at 100%

      // Calculate absorbed and excreted nutrients
      absorbed_nutrients = nutrients_consumed * absorption_rate;
      excreted_nutrients = nutrients_consumed - absorbed_nutrients;

      // 2. Calculate Excretion Components
      // Use dedicated parameters for splitting the excreted mass
      feces_output = excreted_nutrients * Feces_Nutrient_Proportion /* property_080 */;
      urine_output = excreted_nutrients * Urine_Nutrient_Proportion /* property_082 */;

      // 3. Update Resources and Status
      // Update internal animal state
      update_nutrient_levels(absorbed_nutrients);
      update_metabolism_status();

      // Accumulate waste products (outputs for process_011)
      faeces /* resource_049 */ = faeces + feces_output; 
      urine /* resource_050 */ = urine + urine_output; 

      // Consume the input resource (Mass Balance: it has been fully processed)
      nutrients_consumed /* resource_051 */ = 0;" transformationType="Modification">
      <subjects href="#agent_006" type="straight"/>
      <objects href="#agent_006" type="straight"/>
      <involvedResources href="#resource_051" label="Nutrients consumed" type="straight"/>
      <involvedResources href="#resource_040" label="Livestock Health" type="straight"/>
      <involvedResources href="#resource_046" label="Body Condition" type="straight"/>
      <dependsOnParameters href="#property_086" label="Base absorption rate" type="straight"/>
      <dependsOnParameters href="#property_080" label="Feces Nutrient Proportion" type="straight"/>
      <dependsOnParameters href="#property_082" label="Urine Nutrient Proportion" type="straight"/>
      <affectsResources href="#resource_049" label="faeces" type="straight"/>
      <affectsResources href="#resource_050" label="Urine" type="straight"/>
      <affectsResources href="#resource_051" label="Nutrients consumed" type="straight"/>
    </processes>

    <processes xsi:type="ses:TransformationProcess" xmi:id="process_005" id="process_005" name="milking" description="Milk extraction from lactating females" comment="Daily milk yield based on lactation stage, nutrition (via Body Condition), and health." pos_x="-380.03999999999996" pos_y="1584.3199999999997" width="146.0" height="50.0" equation="MilkYield = BaseMilk * NumLactating * LactationCurve * NutritionFactor * HealthFactor" pseudoCode="
      // Get parameters
      base_yield = base_milk_yield /* property_070 */;
      max_yield = maximum_yield /* property_091 */;
      min_yield = minimum_yield /* property_090 */;
      total_lactation_period_tmp = total_lactation_period /* property_071 */;

      // 1. Determine number of lactating females (needs an external counter resource)
      lactating_prop = lactating_proportion /* property_115 */;
      num_lactating = adult_female_count * lactating_prop /* resource_025 */;

      // 2. Calculate Modifiers (DYNAMIC FACTORS)
      days_in_lactation_tmp = days_lactation_avg /* property_116 */;
      stage = days_in_lactation_tmp / total_lactation_period_tmp;
      curve = 1 - (stage * stage); // Decreasing curve (Lactation Curve Factor)

      // Nutrition Factor: Ratio of current Body Condition to optimal
      nutrition_factor = body_condition / optimal_condition /* resource_046 property_114 */;

      // Health Factor: Directly use Livestock Health resource
      health_factor = livestock_health /* resource_040 */;

      // 3. Calculate Total Milk Yield
      total_milk = base_yield * num_lactating * curve * nutrition_factor * health_factor;

      // 4. Apply yield limits
      if (total_milk &lt; min_yield * num_lactating) {
        total_milk = min_yield * num_lactating;
      }
      total_milk = min(total_milk, max_yield * num_lactating);

      // 5. Calculate Labor Consumed
      labor_consumed = num_lactating * labor_rate_milking /* property_034 */;

      // 6. Update Resources (Mass Balance)
      milk /* resource_039 */ = milk + total_milk;
      available_labor /* resource_066 */ = available_labor - labor_consumed;" transformationType="Production">
        <subjects href="#agent_005" type="straight"/>
        <objects href="#agent_006" type="straight"/>
        <involvedResources href="#resource_025" label="Adult Female Count" type="straight"/>
        <involvedResources href="#resource_040" label="Livestock Health" type="straight"/>
        <involvedResources href="#resource_046" label="Body Condition" type="straight"/>
        <involvedResources href="#resource_066" label="Available Labor" type="straight"/>
        <affectsResources href="#resource_039" label="Milk" type="straight"/>
        <dependsOnParameters href="#property_070" label="Base Yield Milk" type="straight"/>
        <dependsOnParameters href="#property_090" label="Minimum Yield" type="straight"/>
        <dependsOnParameters href="#property_091" label="Maximum Yield" type="straight"/>
        <dependsOnParameters href="#property_071" label="Total Lactation Period" type="straight"/>
        <dependsOnParameters href="#property_115" label="Lactating Proportion" type="straight"/>
        <dependsOnParameters href="#property_114" label="Optimal Condition" type="straight"/>
        <dependsOnParameters href="#property_116" label="Days Lactation Avg" type="straight"/>
        <dependsOnParameters href="#property_034" label="Labor Rate Milking" type="straight"/>
        <affectsResources href="#resource_066" label="Available Labor" type="straight"/>
        <affectsResources href="#resource_039" label="Produced Milk" type="straight"/>
    </processes>
    
    <processes xsi:type="ses:TransformationProcess" xmi:id="process_073" id="process_073" name="milk_partitioning" description="Distributes the produced milk into three strategic uses: household consumption, market sale, and calf rearing (retained milk)." comment="This process is critical for linking milk production (resource_039) to income (resource_069) and nutrition (retained for consumption/calf)." pos_x="-380.03999999999996" pos_y="1700.0" width="160.0" height="70.0" equation="\Delta \text{Revenue} = \text{MilkSold} \times \text{Price}" pseudoCode="
      // 1. Get Inputs and Strategic Decisions
      // Total raw milk produced by AgroPastoralHousehold
      total_milk = milk /* resource_039 */;
      consumption_prop = milk_consumption_proportion /* property_145 */;
      sale_prop = sale_milk_proportion /* property_012 */;

      // 2. Calculate Partitioned Quantities 
      milk_sold = total_milk * sale_prop; /* resource_071 */
      milk_consumed = total_milk * consumption_prop; /* resource_070 */ 
      milk_retained = total_milk - milk_consumed - milk_sold; // Residual 

      // 3. Update Resources (Mass Balance)
      // Consume the total produced milk stock
      milk /* resource_039 */ = 0; 

      // Add Milk for Consumption (assuming a resource for household consumption stock)
      milk_for_consumption /* resource_007 */ = milk_for_consumption + milk_consumed; 

      // Note: The Milk_Retained_Calf will affect the Body Condition/Health of calves 
      // in a separate process (e.g., Feeding)." transformationType="Modification">
            <subjects href="#agent_005" label="Agro-Pastoral Households" type="straight"/>
            <objects href="#agent_005" label="Agro-Pastoral Households" type="straight"/>
            <involvedResources href="#resource_039" label="Milk" type="straight"/>
            <involvedResources href="#resource_071" label="Milk Sold" type="straight"/>
            <involvedResources href="#resource_070" label="Milk for Consumption" type="straight"/>
            <dependsOnParameters href="#property_107" label="Milk Sale Proportion" type="straight"/>
            <dependsOnParameters href="#property_108" label="Milk Consumption Proportion" type="straight"/>
            <affectsResources href="#resource_039" label="Milk" type="straight"/>
            <affectsResources href="#resource_071" label="Milk Sold" type="straight"/>
            <affectsResources href="#resource_007" label="Milk for Consumption" type="straight"/>
    </processes>

    <processes xsi:type="ses:TransformationProcess" xmi:id="process_006" id="process_006" name="slaughtering" description="Animal slaughter and processing into carcass based on received animals." comment="Calculates carcass yield from input counts (from animal_sale process), live weight, body condition, and dressing percentage." pos_x="1656.5539999999992" pos_y="1889.3219999999992" width="117.0" height="51.0" equation="CarcassWeight = NumToSlaughter * AvgLiveWeight * BaseDressPct * ConditionFactor" pseudoCode="
      // Initialize total carcass production
      total_carcass = 0;

      // Get condition factor (common to all classes)
      condition_factor = body_condition / Optimal_Condition /* resource_046 property_114 */;
      base_dressing = base_dressing_percentage /* property_098 */;

      // Calculate carcass yield per class (explicit per category, no loop)
      ym_carcass = ym_to_slaughter * weight_ym * base_dressing * condition_factor /* resource_054 */;
      yf_carcass = yf_to_slaughter * weight_yf * base_dressing * condition_factor /* resource_055 */;
      sam_carcass = sam_to_slaughter * weight_sam * base_dressing * condition_factor /* resource_056 */;
      saf_carcass = saf_to_slaughter * weight_saf * base_dressing * condition_factor /* resource_057 */;
      am_carcass = am_to_slaughter * weight_am * base_dressing * condition_factor /* resource_058 */;
      af_carcass = af_to_slaughter * weight_af * base_dressing * condition_factor /* resource_059 */;

      // Sum all class contributions
      total_carcass = ym_carcass + yf_carcass + sam_carcass + saf_carcass + am_carcass + af_carcass;

      // Reset input flow resources (all consumed by slaughter)
      ym_to_slaughter = 0; /* resource_054 */
      yf_to_slaughter = 0; /* resource_055 */
      sam_to_slaughter = 0; /* resource_056 */
      saf_to_slaughter = 0; /* resource_057 */
      am_to_slaughter = 0; /* resource_058 */
      af_to_slaughter = 0; /* resource_059 */

      // Update production resources (Mass Balance)
      Carcass /* resource_017 */ = Carcass + total_carcass;
      meat_production /* resource_036 */ = meat_production + total_carcass;" transformationType="Consumption">
        <subjects href="#agent_022" type="straight"/>
        <objects href="#agent_006" type="straight"/>
        <involvedResources href="#resource_054" label="Young Male to Slaughter" type="straight"/>
        <involvedResources href="#resource_055" label="Young Female to Slaughter" type="straight"/>
        <involvedResources href="#resource_056" label="Sub-Adult Male to Slaughter" type="straight"/>
        <involvedResources href="#resource_057" label="Sub-Adult Female to Slaughter" type="straight"/>
        <involvedResources href="#resource_058" label="Adult Male to Slaughter" type="straight"/>
        <involvedResources href="#resource_059" label="Adult Female to Slaughter" type="straight"/>
        <involvedResources href="#resource_046" label="Body Condition" type="straight"/>
        <involvedResources href="#resource_047" label="Body Weight" type="straight"/>
        <dependsOnParameters href="#property_052" label="Body Weight (default/class weights)" type="straight"/>
        <dependsOnParameters href="#property_011" label="Base Dressing Percentage" type="straight"/> 
        <dependsOnParameters href="#property_114" label="Optimal Condition" type="straight"/> 
        <affectsResources href="#resource_017" label="Carcass" type="straight"/>
        <affectsResources href="#resource_036" label="Meat Production" type="straight"/>
        <affectsResources href="#resource_054" label="Young Male to Slaughter" type="straight"/>
        <affectsResources href="#resource_055" label="Young Female to Slaughter" type="straight"/>
        <affectsResources href="#resource_056" label="Sub-Adult Male to Slaughter" type="straight"/>
        <affectsResources href="#resource_057" label="Sub-Adult Female to Slaughter" type="straight"/>
        <affectsResources href="#resource_058" label="Adult Male to Slaughter" type="straight"/>
        <affectsResources href="#resource_059" label="Adult Female to Slaughter" type="straight"/>
    </processes>

    <processes xsi:type="ses:TransformationProcess" xmi:id="process_015" id="process_015" name="meat_processing" description="Processing of carcasses into meat products" comment="Carcass weight is reduced by losses during trimming, cutting, packaging, and storage to yield final salable meat stock." pos_x="2000.0" pos_y="2000.0" width="150.0" height="60.0" equation="ProcessedMeat = Carcass * TrimmingEff * CuttingEff * (1 - PackagingLoss) * (1 - StorageLoss)" pseudoCode="
      // Input: Total carcass mass available for processing (resource_017)
      carcass_initial_weight = carcass /* resource_017 */;

      // If there is carcass to process
      if (initial_weight > 0) {
        // 1. Apply trimming efficiency loss
        trimming_efficiency = trimming_efficiency /* property_092 */;
        trimmed_weight = initial_weight * trimming_efficiency;

        // 2. Apply cutting efficiency loss
        cutting_efficiency = cutting_efficiency /* property_093 */;
        cut_weight = trimmed_weight * cutting_efficiency;

        // 3. Apply packaging loss
        packaging_loss = packaging_loss /* property_094 */;
        packaged_weight = cut_weight * (1 - packaging_loss);

        // 4. Apply storage loss
        storage_loss = storage_loss /* property_095 */;
        stored_weight = packaged_weight * (1 - storage_loss);

        // 5. Update Inventory and Production

        // Decrease Carcass stock (consumed input)
        carcass /* resource_017 */ = carcass - carcass_initial_weight; 
        
        // Increase Processed Meat Stock (new salable output)
        Processed_Meat_Stock /* resource_060 */ = Processed_Meat_Stock + stored_weight; 

        // Record Waste (difference between input and final output)
        waste_mass = initial_weight - stored_weight;
        // record_waste_statistics(waste_mass)  // placeholder for statistics logging
      } else {
        // No carcass to process, no change
        stored_weight = 0;
      }" transformationType="Modification">
          <subjects href="#agent_022" type="straight"/>
