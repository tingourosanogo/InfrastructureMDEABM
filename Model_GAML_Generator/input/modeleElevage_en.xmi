    <processes xsi:type="ses:MovementProcess" xmi:id="process_016" id="process_016" name="animal_sale" description="Commercial sale of live animals by AgroPastoralHouseholds, generating cash revenue." comment="For each class, an off-take rate determines the number sold. Revenue is based on the number sold and the live price." pos_x="1028.4819999999997" pos_y="618.6400000000001" width="180.0" height="70.0" equation="For each class i: NumToSell_i = Count_i * OfftakeRate_i; ΔCash = Σ(NumToSell_i * LivePrice)" pseudoCode="
      // Initialize revenue
      sold_amount = 0;
      live_price = live_animal_price /* property_107 */;

      // Calculate sales and slaughter flows per class (explicit, no loop)

      // Young Male
      to_sell_ym = round(young_male_count * offtake_young_male);
      if (to_sell_ym &gt; 0) {
        sold_amount = sold_amount +(to_sell_ym * live_price);
        young_male_count /* resource_019 */ = young_male_count - to_sell_ym;
        ym_to_slaughter /* resource_054 */ = round(to_sell_ym * slaughter_prop_ym);
      } else {
        ym_to_slaughter /* resource_054 */ = 0;
      }

      // Young Female
      to_sell_yf = round(young_female_count * offtake_young_female);
      if (to_sell_yf &gt; 0) {
        sold_amount = sold_amount + (to_sell_yf * live_price);
        young_female_count /* resource_021 */ = young_female_count - to_sell_yf;
        yf_to_slaughter /* resource_055 */ = round(to_sell_yf * slaughter_prop_yf);
      } else {
        yf_to_slaughter /* resource_055 */ = 0;
      }

      // Sub-Adult Male
      to_sell_sam = round(sub_adult_male_count * offtake_sub_adult_male);
      if (to_sell_sam &gt; 0) {
        sold_amount = sold_amount + (to_sell_sam * live_price);
        sub_adult_male_count /* resource_022 */ = sub_adult_male_count - to_sell_sam;
        sam_to_slaughter /* resource_056 */ = round(to_sell_sam * slaughter_prop_sam);
      } else {
        sam_to_slaughter /* resource_056 */ = 0;
      }

      // Sub-Adult Female
      to_sell_saf = round(sub_adult_female_count * offtake_sub_adult_female);
      if (to_sell_saf &gt; 0) {
        sold_amount = sold_amount + (to_sell_saf * live_price);
        sub_adult_female_count /* resource_023 */ = sub_adult_female_count - to_sell_saf;
        saf_to_slaughter /* resource_057 */ = round(to_sell_saf * slaughter_prop_saf);
      } else {
        saf_to_slaughter /* resource_057 */ = 0;
      }

      // Adult Male
      to_sell_am = round(adult_male_count * offtake_adult_male);
      if (to_sell_am &gt; 0) {
        sold_amount = sold_amount + (to_sell_am * live_price);
        adult_male_count /* resource_024 */ = adult_male_count - to_sell_am;
        am_to_slaughter /* resource_058 */ = round(to_sell_am * slaughter_prop_am);
      } else {
        am_to_slaughter /* resource_058 */ = 0;
      }

      // Adult Female
      to_sell_af = round(adult_female_count * offtake_adult_female);
      if (to_sell_af &gt; 0) {
        sold_amount = sold_amount + (to_sell_af * live_price);
        adult_female_count /* resource_025 */ = adult_female_count - to_sell_af;
        af_to_slaughter /* resource_059 */ = round(to_sell_af * slaughter_prop_af);
      } else {
        af_to_slaughter /* resource_059 */ = 0;
      }

      // Update Household's Cash (Revenue from live sales)
      revenue /* resource_067 */ = revenue + sold_amount;" transformationType="Movement">
      <subjects href="#agent_005" type="straight"/>
      <objects href="#agent_013" label="Market" type="straight"/>
      <objects href="#agent_022" label="Slaughterhouse" type="straight"/>
      <involvedResources href="#resource_019" label="Young Male Count" type="straight"/>
      <involvedResources href="#resource_021" label="Young Female Count" type="straight"/>
      <involvedResources href="#resource_022" label="Sub-Adult Male Count" type="straight"/>
      <involvedResources href="#resource_023" label="Sub-Adult Female Count" type="straight"/>
      <involvedResources href="#resource_024" label="Adult Male Count" type="straight"/>
