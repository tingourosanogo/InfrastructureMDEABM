    <processes xsi:type="ses:MovementProcess" xmi:id="process_009" id="process_009" name="migration" description="Long-distance seasonal migration of pastoral herds" comment="Strategic movement decision based on pre-calculated fodder reliance (from feeding process), water scarcity, climate stress, and traditional knowledge." pos_x="600.0" pos_y="1800.0" width="130.0" height="50.0" equation="MigrationDecision = ResourceScarcity * ClimateStress * TraditionalTiming" pseudoCode="
      // 1. Retrieve Pre-calculated Decision Drivers

      // A. Fodder Scarcity (DIRECT LINK TO FEEDING PROCESS)
      // If Reliance is 1, household MUST migrate to find seasonal fodder.
      seasonal_fodder_reliance = seasonal_fodder_reliance /* resource_073 */;
      fodder_scarcity = seasonal_fodder_reliance; 

      // B. Water Scarcity
      // Compute herd biomass (kg) from class counts
      total_animals = young_male_count 
                    + young_female_count 
                    + sub_adult_male_count 
                    + sub_adult_female_count 
                    + adult_male_count 
                    + adult_female_count;
      herd_biomass = total_animals * body_weight_default /* property_052 */;

      current_water = seasonal_water + rainfall /* resource_010 */; 
      required_water = herd_biomass * water_consumption_rate /* property_061 */;

      if (required_water > 1e-6) {
        water_status = current_water / required_water;
        water_scarcity = 1 - min(1.0, water_status);
      } else {
        water_scarcity = 0; // No required water means no scarcity
      }

      // Overall Resource Scarcity
      resource_scarcity = max(fodder_scarcity, water_scarcity); // Use the highest pressure point

      // 2. Environmental stress (Climate)
      // (Calculations remain simplified and rely on external functions/properties for details)
      rainfall_variability = min(1.5, max(0.5, rainfall / rainfall_normal));
      temperature_factor = min(1, temperature / temp_opt);
      climate_stress = rainfall_variability * temperature_factor;

      // 3. Traditional knowledge influence
      seasonal_timing = saison /* property_098 */; 

      // 4. Decision making: Calculate Migration Pressure
      migration_pressure = resource_scarcity * climate_stress * seasonal_timing;

      movement_threshold = movement_threshold /* property_049 */;

      if (migration_pressure > movement_threshold) {
        // Plan migration
        min_herd_condition = min_herd_condition /* property_100 */;
        current_herd_condition = herd_condition /* resource_046 */;
        
        // Execute movement is contingent on herd health and minimum condition
        if (current_herd_condition > min_herd_condition) {
          move_herd(destination);
          update_resource_access(); // New access to external Seasonal Fodder is granted
          adapt_herd_management();
          update_herd_condition();
          update_resource_use(); 
        }
      }" transformationType="Movement">
      <subjects href="#agent_005" label="AgroPastoralHouseholds" type="straight"/>
      <objects href="#agent_006" label="Livestock" type="straight"/>
      <involvedResources href="#resource_019" label="Young Male Count" type="straight"/>
      <involvedResources href="#resource_021" label="Young Female Count" type="straight"/>
